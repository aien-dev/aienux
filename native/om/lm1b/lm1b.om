fn rowcp a ulong n ulong to void
p = shr a 24
o = and a 16777215
k = n
if gt add o n 16777216
k = sub 16777216 o
end
cpseg p o 0 k
if lt k n
cpseg add p 1 0 k sub n k
end
end
fn mv ti ulong xo ulong yo ulong rows ulong cols ulong to void
ty = get tty ti
nb = div cols 256
rbs = mul nb 144
if eq ty 14
rbs = mul nb 210
else
if ne ty 12
trap 10
end
end
base = get tof ti
for r ulong rows
rowcp add base mul r rbs rbs
v = f32 0.0
if eq ty 12
v = bitcast f32 dq4 nb xo
else
v = bitcast f32 dq6 nb xo
end
put ac add yo r v
end
put st SRB add get st SRB mul rows rbs
end
note ---- scalar math (src/math.rs) ----
fn msqrt x f32 to uint
if le x 0.0
ret uint 0
end
y = bitcast f32 add shr bitcast uint x 1 532676608
for i ulong 5
y = mul 0.5 add y div x y
end
ret bitcast uint y
end
fn mexp a f32 to uint
x = a
if lt x get cf KM87
x = get cf KM87
end
if gt x get cf K88
x = get cf K88
end
sc = mul x get cf KL2E
n = int 0
if ge sc 0.0
n = int add sc 0.5
else
n = int sub sc 0.5
end
nf = f32 n
r = sub sub x mul nf get cf KHI mul nf get cf KLO
t = add get cf K120 div r 720.0
t = add get cf K24 mul r t
t = add get cf K6 mul r t
t = add 0.5 mul r t
t = add 1.0 mul r t
p = add 1.0 mul r t
ret bitcast uint mul p bitcast f32 shl uint add n 127 23
end
fn mln a f32 to uint
b = bitcast uint a
e = sub int and shr b 23 255 127
m = bitcast f32 or and b 8388607 1065353216
if gt m get cf KSQ2
m = mul m 0.5
e = add e 1
end
y = div sub m 1.0 add m 1.0
y2 = mul y y
t = add get cf K9 div y2 11.0
t = add get cf K7 mul y2 t
t = add get cf K5 mul y2 t
t = add get cf K3 mul y2 t
t = add 1.0 mul y2 t
s = mul y t
ret bitcast uint add mul 2.0 s mul f32 e get cf KLN2
end
fn fmodp x f32 y f32 to uint
note exact fmod for finite x >= 0 and normal y > 0 (integer long division, as musl fmodf)
bx = bitcast uint x
by = bitcast uint y
ex = and shr bx 23 255
ey = and shr by 23 255
if or or ge ex 255 ne shr bx 31 0 or lt ey 24 ge ey 255
trap 11
end
if lt x y
ret bx
end
mx = ulong or and bx 8388607 8388608
my = ulong or and by 8388607 8388608
r = mx
k = sub ex ey
for i uint k
if ge r my
r = sub r my
end
r = shl r 1
end
if ge r my
r = sub r my
end
if eq r 0
ret uint 0
end
ret bitcast uint mul f32 r bitcast f32 shl sub ey 23 23
end
fn sincos a f32 i ulong to void
r = bitcast f32 fmodp add a get cf KPI get cf KTAU
if lt r 0.0
r = add r get cf KTAU
end
x = sub r get cf KPI
cs = f32 1.0
if gt x get cf KPI2
x = sub get cf KPI x
cs = f32 -1.0
else
if lt x neg get cf KPI2
x = sub neg get cf KPI x
cs = f32 -1.0
end
end
x2 = mul x x
t = mul x2 get cf K362
t = sub t get cf K5040
t = mul x2 t
t = add get cf K120 t
t = mul x2 t
t = sub t get cf K6
t = mul x2 t
t = add 1.0 t
put ac add ARS i mul x t
u = sub get cf K40320 div x2 3628800.0
u = mul x2 u
u = sub u get cf K720
u = mul x2 u
u = add get cf K24 u
u = mul x2 u
u = sub u 0.5
u = mul x2 u
u = add 1.0 u
put ac add ARC i mul cs u
end
fn initc to void
put cf K3 div f32 1.0 3.0
put cf K5 div f32 1.0 5.0
put cf K7 div f32 1.0 7.0
put cf K9 div f32 1.0 9.0
put cf K6 div f32 1.0 6.0
put cf K24 div f32 1.0 24.0
put cf K120 div f32 1.0 120.0
put cf K5040 div f32 1.0 5040.0
put cf K362 div f32 1.0 362880.0
put cf K720 div f32 1.0 720.0
put cf K40320 div f32 1.0 40320.0
put cf KPI bitcast f32 uint 1078530011
put cf KTAU bitcast f32 uint 1086918619
put cf KPI2 bitcast f32 uint 1070141403
put cf KLN2 bitcast f32 uint 1060205080
put cf KL2E bitcast f32 uint 1069066811
put cf KSQ2 bitcast f32 uint 1068827891
put cf KHI bitcast f32 uint 1060208640
put cf KLO bitcast f32 uint 3109978243
put cf KNINF bitcast f32 uint 4286578688
put cf KEPS bitcast f32 uint 925353388
put cf KNZ bitcast f32 uint 2147483648
put cf KM87 f32 -87.0
put cf K88 f32 88.0
put cf KSCALE div f32 1.0 bitcast f32 msqrt f32 64.0
base = bitcast f32 uint 1223959552
put cf KTS bitcast f32 mexp mul f32 -0.03125 bitcast f32 mln base
end
note ---- the forward pass (src/decode.rs) ----
fn rmsn xo ulong wo ulong yo ulong to void
ss = get cf KNZ
for i ulong NE
v = get ac add xo i
ss = add ss mul v v
end
ss = div ss 2048.0
sc = div 1.0 bitcast f32 msqrt add ss get cf KEPS
for i ulong NE
v = mul get ac add xo i sc
put ac add yo i mul v get nw add wo i
end
end
fn ropec pos ulong to void
ts = get cf KTS
th = f32 pos
for i ulong 32
sincos div th get rf i i
th = mul th ts
end
end
fn ropea o ulong nh ulong to void
for h ulong nh
for i ulong 32
j = add add o mul h 64 mul i 2
a = get ac j
b = get ac add j 1
c = get ac add ARC i
s = get ac add ARS i
put ac j sub mul a c mul b s
put ac add j 1 add mul a s mul b c
end
end
end
fn smax n ulong to void
mx = get cf KNINF
for t ulong n
mx = fmax mx get ac add ASC t
end
sm = f32 0.0
for t ulong n
v = bitcast f32 mexp sub get ac add ASC t mx
put ac add ASC t v
sm = add sm v
end
for t ulong n
put ac add ASC t div get ac add ASC t sm
end
end
fn ascore qo ulong kv ulong t ulong to uint
note q . k over one head (64 values), summed in order from -0.0
kq = add kv mul t KVD
s = get cf KNZ
for i ulong 64
v = mul get ac add qo i get kc add kq i
s = add s v
end
ret bitcast uint s
end
fn aacc ao ulong kv ulong t ulong to void
vo = add kv mul t KVD
w = get ac add ASC t
for i ulong 64
v = mul w get vc add vo i
put ac add ao i add get ac add ao i v
end
end
fn ahead base ulong np ulong h ulong to void
kv = add base mul div h 4 64
qo = add AQ mul h 64
for t ulong np
s = bitcast f32 ascore qo kv t
put ac add ASC t mul s get cf KSCALE
end
smax np
ao = add AAT mul h 64
for i ulong 64
put ac add ao i 0.0
end
for t ulong np
aacc ao kv t
end
end
fn attn l ulong pos ulong to void
base = mul l mul CTX KVD
for h ulong 32
ahead base add pos 1 h
end
end
fn resid to void
for i ulong NE
put ac add AX i add get ac add AX i get ac add AT i
end
end
fn kvst l ulong pos ulong to void
at = add mul l mul CTX KVD mul pos KVD
for i ulong KVD
put kc add at i get ac add AK i
put vc add at i get ac add AV i
end
end
fn silu to void
for i ulong NF
g = get ac add AG i
e = add 1.0 bitcast f32 mexp neg g
put ac add AG i mul div g e get ac add AU i
end
end
fn fwd tok ulong pos ulong want bool to void
rowcp add get tof 144 mul tok 1680 1680
put st SRB add get st SRB 1680
dv6 8 AX
ropec pos
for l ulong 16
rmsn AX mul l NE AH
li = mul l 9
mv li AH AQ 2048 2048
mv add li 1 AH AK 512 2048
mv add li 2 AH AV 512 2048
ropea AQ 32
ropea AK 8
kvst l pos
attn l pos
mv add li 3 AAT AT 2048 2048
resid
if and eq l 8 eq pos get st SFLT
trap 12
end
rmsn AX mul add 16 l NE AH
mv add li 6 AH AG 8192 2048
mv add li 7 AH AU 8192 2048
silu
mv add li 8 AG AT 2048 8192
resid
end
if want
rmsn AX mul 32 NE AH
mv 144 AH ALG NV 2048
end
end
fn amax to ulong
best = ulong 0
bv = get ac ALG
for i ulong NV
v = get ac add ALG i
if gt v bv
best = i
bv = v
end
end
ret best
end
note ---- load: read, digest, admit ----
fn loadf32 a ulong n ulong dst ulong to void
note n little-endian f32 values at file address a into nw at dst
for i ulong n
o = add a mul i 4
v = or or uint fb o shl uint fb add o 1 8 or shl uint fb add o 2 16 shl uint fb add o 3 24
put nw add dst i bitcast f32 v
end
end
