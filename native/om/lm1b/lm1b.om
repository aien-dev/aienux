note ---- requests ----
fn getln to long
note next request line in ib at st SLS; length, -1 at end of input, -2 for a line over the buffer
while true bound 999999
s = get st SSTART
f = get st SFILL
i = s
while lt i f bound 999999
if eq get ib i 10
put st SSTART add i 1
if eq get st SSKIP 1
put st SSKIP 0
ret long -2
end
put st SLS s
ret long sub i s
end
i = add i 1
end
if eq get st SEOF 1
if lt s f
put st SSTART f
if eq get st SSKIP 1
put st SSKIP 0
ret long -2
end
put st SLS s
ret long sub f s
end
if eq get st SSKIP 1
put st SSKIP 0
ret long -2
end
ret long -1
end
n = sub f s
for j ulong n
put ib j get ib add s j
end
if eq n IBCAP
n = ulong 0
put st SSKIP 1
end
put st SSTART 0
put st SFILL n
r = read int 0 ib n sub IBCAP n
if le r 0
put st SEOF 1
else
put st SFILL add n ulong r
end
end
ret long -1
end
fn tword k ulong to bool
note the request word k at the cursor, then a space or the line end; the cursor moves past the word
p = get st SPC
e = get st SPE
n = ulong 0
for i ulong 16
c = get tw add mul k 16 i
if eq c 32
break
end
n = add n 1
end
if gt add p n e
ret false
end
for i ulong n
if ne get ib add p i get tw add mul k 16 i
ret false
end
end
q = add p n
if lt q e
if ne get ib q 32
ret false
end
end
put st SPC q
ret true
end
fn tsp to bool
note exactly one space, then more text
p = get st SPC
e = get st SPE
if ge add p 1 e
ret false
end
if ne get ib p 32
ret false
end
if eq get ib add p 1 32
ret false
end
put st SPC add p 1
ret true
end
fn tnum to ulong
note a decimal number of 1..18 digits; anything else sets st SERR
p = get st SPC
e = get st SPE
v = ulong 0
n = ulong 0
while lt p e bound 100
c = get ib p
if eq c 32
break
end
if or lt c 48 gt c 57
put st SERR 1
ret 0
end
v = add mul v 10 ulong sub c 48
n = add n 1
if gt n 18
put st SERR 1
ret 0
end
p = add p 1
end
if eq n 0
put st SERR 1
end
put st SPC p
ret v
end
fn oid to void
n = get st SIDN
if eq n 0
ow WQMARK
ret
end
s = get st SIDS
for i ulong n
oc get ib add s i
end
end
fn jref w ulong to void
put st SOB 0
ow WJOB
osp
oid
osp
ow WSTATUS
osp
ow WREFUSED
osp
ow WREASON
osp
ow w
onl
end
fn tfield k ulong to ulong
note " <word k> <number>"; a failure sets st SERR
if not tsp
put st SERR 1
ret 0
end
if not tword k
put st SERR 1
ret 0
end
if not tsp
put st SERR 1
ret 0
end
ret tnum
end
fn pid to bool
note the job id: 1..32 printable bytes up to the next space
p = get st SPC
e = get st SPE
q = p
while lt q e bound 100
c = get ib q
if eq c 32
break
end
if or lt c 33 gt c 126
ret false
end
q = add q 1
end
if gt sub q p 32
ret false
end
put st SIDS p
put st SIDN sub q p
put st SPC q
ret true
end
fn pids to ulong
note " <id>" repeated to the line end into ids; returns the count or a refusal word plus 1000
k = ulong 0
while lt get st SPC get st SPE bound 100000
if not tsp
ret add WSYNTAX 1000
end
v = tnum
if eq get st SERR 1
ret add WSYNTAX 1000
end
if ge k CTX
ret add WTOOMANY 1000
end
if ge v NV
ret add WBADID 1000
end
put ids k v
k = add k 1
end
ret k
end
fn parse ls ulong n ulong to ulong
note fills SIDS SIDN SGEN SBUD SSTOP SFAULT SNID and ids; returns 99 when accepted, else a refusal word
put st SPC ls
put st SPE add ls n
put st SERR 0
put st SIDN 0
if not tword WJOB
ret WSYNTAX
end
if not tsp
ret WSYNTAX
end
if not pid
ret WSYNTAX
end
put st SGEN tfield WGEN
put st SBUD tfield WBUDGET
put st SSTOP tfield WSTOP
put st SFAULT tfield WFAULT
if eq get st SERR 1
ret WSYNTAX
end
if not tsp
ret WSYNTAX
end
if not tword WIDS
ret WSYNTAX
end
k = pids
if ge k 1000
ret sub k 1000
end
if eq k 0
ret WEMPTY
end
if or eq get st SGEN 0 gt get st SFAULT 1
ret WRANGE
end
if gt sub add k get st SGEN 1 CTX
ret WCONTEXT
end
put st SNID k
ret 99
end
fn tpush t ulong to void
nt = get st SNTOK
put tk nt t
put tb nt ulong bitcast uint get ac add ALG t
put st SNTOK add nt 1
end
fn jrun to ulong
note prefill then greedy steps; returns the passes run; st SCAN 1 when the budget ran out
n = get st SNID
bud = get st SBUD
put st SRB 0
put st SCAN 0
put st SNTOK 0
put st SFLT 4294967295
if eq get st SFAULT 1
put st SFLT div n 2
end
pos = ulong 0
for i ulong n
if ge pos bud
put st SCAN 1
ret pos
end
fwd get ids i pos eq add i 1 n
pos = add pos 1
end
for s ulong get st SGEN
t = amax
tpush t
if eq t get st SSTOP
ret pos
end
if eq add s 1 get st SGEN
ret pos
end
if ge pos bud
put st SCAN 1
ret pos
end
fwd t pos true
pos = add pos 1
end
ret pos
end
fn kvclr pos ulong to void
note discard this job's KV state (the weights stay resident)
for l ulong 16
for p ulong pos
at = add mul l mul CTX KVD mul p KVD
for i ulong KVD
put kc add at i 0.0
put vc add at i 0.0
end
end
end
end
fn jout pos ulong to void
nt = get st SNTOK
put st SOB 0
ow WJOB
osp
oid
osp
ow WSTATUS
osp
if eq get st SCAN 1
ow WCANCEL
else
ow WOK
end
osp
ow WPASSES
osp
ou pos
osp
ow WTOKENS
for i ulong nt
osp
ou get tk i
end
onl
ow WBITS
for i ulong nt
osp
ou get tb i
end
onl
ow WACCT
osp
ow WJOB
osp
oid
osp
ow WROWB
osp
ou get st SRB
osp
ow WPASSES
osp
ou pos
onl
end
fn runjob to void
pos = jrun
kvclr pos
jout pos
end
fn main to int
admit
while true bound 999999
n = getln
if eq n -1
ret 0
end
if eq n -2
put st SIDN 0
jref WTOOLONG
continue
end
if eq n 0
continue
end
w = parse get st SLS ulong n
if ne w 99
jref w
continue
end
runjob
end
ret 0
end
