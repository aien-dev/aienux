fn rowcp a ulong n ulong to void
p = shr a 24
o = and a 16777215
k = n
if gt add o n 16777216
k = sub 16777216 o
end
cpseg p o 0 k
if lt k n
cpseg add p 1 0 k sub n k
end
end
fn mv ti ulong xo ulong yo ulong rows ulong cols ulong to void
ty = get tty ti
nb = div cols 256
rbs = mul nb 144
if eq ty 14
rbs = mul nb 210
else
if ne ty 12
trap 10
end
end
base = get tof ti
for r ulong rows
rowcp add base mul r rbs rbs
v = f32 0.0
if eq ty 12
v = bitcast f32 dq4 nb xo
else
v = bitcast f32 dq6 nb xo
end
put ac add yo r v
end
put st SRB add get st SRB mul rows rbs
end
note ---- scalar math (src/math.rs) ----
fn msqrt x f32 to uint
if le x 0.0
ret uint 0
end
y = bitcast f32 add shr bitcast uint x 1 532676608
for i ulong 5
y = mul 0.5 add y div x y
end
ret bitcast uint y
end
fn mexp a f32 to uint
x = a
if lt x get cf KM87
x = get cf KM87
end
if gt x get cf K88
x = get cf K88
end
sc = mul x get cf KL2E
n = int 0
if ge sc 0.0
n = int add sc 0.5
else
n = int sub sc 0.5
end
nf = f32 n
r = sub sub x mul nf get cf KHI mul nf get cf KLO
t = add get cf K120 div r 720.0
t = add get cf K24 mul r t
t = add get cf K6 mul r t
t = add 0.5 mul r t
t = add 1.0 mul r t
p = add 1.0 mul r t
ret bitcast uint mul p bitcast f32 shl uint add n 127 23
end
fn mln a f32 to uint
b = bitcast uint a
e = sub int and shr b 23 255 127
m = bitcast f32 or and b 8388607 1065353216
if gt m get cf KSQ2
m = mul m 0.5
e = add e 1
end
y = div sub m 1.0 add m 1.0
y2 = mul y y
t = add get cf K9 div y2 11.0
t = add get cf K7 mul y2 t
t = add get cf K5 mul y2 t
t = add get cf K3 mul y2 t
t = add 1.0 mul y2 t
s = mul y t
ret bitcast uint add mul 2.0 s mul f32 e get cf KLN2
end
fn fmodp x f32 y f32 to uint
note exact fmod for finite x >= 0 and normal y > 0 (integer long division, as musl fmodf)
bx = bitcast uint x
by = bitcast uint y
ex = and shr bx 23 255
ey = and shr by 23 255
if or or ge ex 255 ne shr bx 31 0 or lt ey 24 ge ey 255
trap 11
end
if lt x y
ret bx
end
mx = ulong or and bx 8388607 8388608
my = ulong or and by 8388607 8388608
r = mx
k = sub ex ey
for i uint k
if ge r my
r = sub r my
end
r = shl r 1
end
if ge r my
r = sub r my
end
if eq r 0
ret uint 0
end
ret bitcast uint mul f32 r bitcast f32 shl sub ey 23 23
end
fn sincos a f32 i ulong to void
r = bitcast f32 fmodp add a get cf KPI get cf KTAU
if lt r 0.0
r = add r get cf KTAU
end
x = sub r get cf KPI
cs = f32 1.0
if gt x get cf KPI2
x = sub get cf KPI x
cs = f32 -1.0
else
if lt x neg get cf KPI2
x = sub neg get cf KPI x
cs = f32 -1.0
end
end
x2 = mul x x
t = mul x2 get cf K362
t = sub t get cf K5040
t = mul x2 t
t = add get cf K120 t
t = mul x2 t
t = sub t get cf K6
t = mul x2 t
t = add 1.0 t
put ac add ARS i mul x t
u = sub get cf K40320 div x2 3628800.0
u = mul x2 u
u = sub u get cf K720
u = mul x2 u
u = add get cf K24 u
u = mul x2 u
u = sub u 0.5
u = mul x2 u
u = add 1.0 u
put ac add ARC i mul cs u
