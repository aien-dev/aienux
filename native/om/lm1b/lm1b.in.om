note ---- output: one line at a time in ob, flushed on newline ----
fn oc c uchar to void
n = get st SOB
put ob n c
put st SOB add n 1
end
fn ow k ulong to void
for i ulong 16
c = get tw add mul k 16 i
if eq c 32
ret
end
oc c
end
end
fn osp to void
oc 32
end
fn ou v ulong to void
d = new uchar 24 0
n = ulong 0
x = v
while true bound 30
put d n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
for i ulong n
oc get d sub sub n 1 i
end
end
fn onl to void
oc 10
n = get st SOB
r = write int 1 ob 0 n
if ne r long n
exit 4
end
put st SOB 0
end
fn refuse w ulong to void
put st SOB 0
ow WLOAD
osp
ow WREFUSED
osp
ow WREASON
osp
ow w
onl
exit 3
end
note ---- manifest text rebuilt from the header, compared byte for byte with the pinned text ----
fn mc c uchar to void
n = get st SMF
if ge n 65536
refuse WMANI
end
put mf n c
put st SMF add n 1
end
fn mu v ulong to void
d = new uchar 24 0
n = ulong 0
x = v
while true bound 30
put d n uchar add 48 rem x 10
n = add n 1
x = div x 10
if eq x 0
break
end
end
for i ulong n
mc get d sub sub n 1 i
end
end
fn msg v ulong nb ulong to void
note signed decimal of the low nb bits of v (nb 8, 16, 32 or 64)
x = v
neg1 = false
if eq nb 64
if ne shr x 63 0
neg1 = true
end
else
if ne and shr x sub nb 1 1 0
neg1 = true
x = or x not sub shl ulong 1 nb 1
end
end
if neg1
mc 45
mu neg x
else
mu x
end
end
fn hrd to ulong
c = get st SCUR
if ge c 16777216
refuse WHEADER
end
put st SCUR add c 1
ret ulong get m0 c
end
fn hrn n ulong to ulong
v = ulong 0
for i ulong n
v = or v shl hrd mul i 8
end
ret v
end
fn mstr to void
note a GGUF string: its length, then the bytes when short and plain (rule shared with the Rust dumper)
n = hrn 8
c = get st SCUR
if gt n 16777216
refuse WHEADER
end
if gt add c n 16777216
refuse WHEADER
end
ok = le n 40
for i ulong n
b = get m0 add c i
if or or lt b 32 gt b 126 or eq b 34 eq b 92
ok = false
end
end
mu n
if ok
mc 32
for i ulong n
mc get m0 add c i
end
end
put st SCUR add c n
end
fn tsize e ulong to ulong
if or or eq e 0 eq e 1 eq e 7
ret 1
end
if or eq e 2 eq e 3
ret 2
end
if or or eq e 4 eq e 5 eq e 6
ret 4
end
if or or eq e 10 eq e 11 eq e 12
ret 8
end
ret 0
end
fn mval t ulong to void
note one metadata value of type t, as the manifest prints it
if or or eq t 0 eq t 2 eq t 4
mu hrn tsize t
ret
end
if eq t 10
mu hrn 8
ret
end
if or eq t 6 eq t 12
mu hrn tsize t
ret
end
if eq t 7
mu hrn 1
ret
end
if or or eq t 1 eq t 3 eq t 5
sz = tsize t
msg hrn sz mul sz 8
ret
end
if eq t 11
msg hrn 8 64
ret
end
if eq t 8
mstr
ret
end
if eq t 9
e = hrn 4
n = hrn 8
mu e
mc 32
mu n
sz = tsize e
if ne sz 0
c = get st SCUR
if gt n 16777216
refuse WHEADER
end
put st SCUR add c mul n sz
ret
end
if ne e 8
refuse WHEADER
end
if gt n 999999
refuse WHEADER
end
for i ulong n
k = hrn 8
if gt k 16777216
refuse WHEADER
end
put st SCUR add get st SCUR k
end
ret
end
refuse WHEADER
end
fn header to void
put st SCUR 0
put st SMF 0
if ne hrn 4 1179993927
refuse WMAGIC
end
v = hrn 4
nt = hrn 8
nk = hrn 8
if or gt nt 160 gt nk 1024
refuse WHEADER
end
mc 103
mc 103
mc 117
mc 102
mc 32
mu v
mc 32
mu nt
mc 32
mu nk
mc 10
hkvs nk
htens nt
hdone nt
end
fn hkvs nk ulong to void
for i ulong nk
mc 107
mc 118
mc 32
mstr
t = hrn 4
mc 32
mu t
mc 32
mval t
mc 10
end
end
fn htens nt ulong to void
for i ulong nt
mc 116
mc 32
n = hrn 8
c = get st SCUR
if gt n 255
refuse WHEADER
end
for j ulong n
mc get m0 add c j
end
put st SCUR add c n
nd = hrn 4
if or lt nd 1 gt nd 2
refuse WMANI
end
d0 = hrn 8
d1 = ulong 1
if eq nd 2
d1 = hrn 8
end
ty = hrn 4
of = hrn 8
mc 32
mu ty
mc 32
mu nd
mc 32
mu d0
mc 32
mu d1
mc 32
mu of
mc 10
put toff i of
put ttyp i ty
end
end
fn hdone nt ulong to void
ds = and add get st SCUR 31 not ulong 31
mc 100
mc 97
mc 116
mc 97
mc 32
mu ds
mc 10
put st SDS ds
n = get st SMF
if ne n len man
refuse WMANI
end
for i ulong n
if ne get mf i get man i
refuse WMANI
end
end
for i ulong nt
s = ulong 0
for j ulong 3
s = add mul s 10 ulong sub get tslot add mul i 3 j 48
end
put tof s add ds get toff i
put tty s get ttyp i
end
end
note ---- f16 and the K-quant dot products (src/half.rs, src/quant.rs) ----
fn f16 lo uchar hi uchar to uint
h = or uint lo shl uint hi 8
sg = shl shr h 15 31
ex = and shr h 10 31
mn = and h 1023
if eq ex 0
if eq mn 0
ret sg
end
m = mn
sh = uint 0
while lt m 1024 bound 16
m = shl m 1
sh = add sh 1
end
ret or or sg shl sub 113 sh 23 shl and m 1023 13
end
if eq ex 31
ret or or sg 2139095040 shl mn 13
end
ret or or sg shl add ex 112 23 shl mn 13
end
fn scm o ulong j ulong to uint
note scale_min_k4: scale in the low byte, min in the next byte
if lt j 4
a = get rb add o j
b = get rb add o add j 4
ret or uint and a 63 shl uint and b 63 8
end
a = get rb add o add j 4
b = get rb add o sub j 4
c = get rb add o j
sc = or and a 15 shl shr b 6 4
m = or shr a 4 shl shr c 6 4
ret or uint sc shl uint m 8
end
fn dq4h s f32 qo ulong xj ulong sh ulong to uint
note 32 weights of one Q4_K sub-block (low nibbles when sh is 0, high when 4), summed in order
d1 = get kd 2
n1 = get kd 3
a = s
for l ulong 32
q = shr get rb add qo l sh
w = sub mul d1 f32 and q 15 n1
a = add a mul w get ac add xj l
end
ret bitcast uint a
end
fn dq4j o ulong xb ulong j ulong s f32 to uint
note sub-blocks 2 j and 2 j + 1; kd holds d, dmin, then this sub-block scale and min
p = scm add o 4 mul j 2
put kd 2 mul get kd 0 f32 and p 255
put kd 3 mul get kd 1 f32 shr p 8
t = bitcast f32 dq4h s add o add 16 mul j 32 add xb mul j 64 0
p = scm add o 4 add mul j 2 1
put kd 2 mul get kd 0 f32 and p 255
put kd 3 mul get kd 1 f32 shr p 8
ret dq4h t add o add 16 mul j 32 add add xb mul j 64 32 4
end
fn dq4b o ulong xb ulong to uint
note one Q4_K block (144 bytes at rb o) against 256 activations at ac xb: dequantize, then sum in order
put kd 0 bitcast f32 f16 get rb o get rb add o 1
put kd 1 bitcast f32 f16 get rb add o 2 get rb add o 3
s = get cf KNZ
for j ulong 4
s = bitcast f32 dq4j o xb j s
end
ret bitcast uint s
end
fn dq4 nb ulong xo ulong to uint
acc = f32 0.0
for b ulong nb
acc = add acc bitcast f32 dq4b mul b 144 add xo mul b 256
end
ret bitcast uint acc
end
fn i8f u uchar to uint
v = int u
if ge v 128
v = sub v 256
end
ret bitcast uint f32 v
end
fn q6v k ulong p ulong to int
note one 6-bit Q6_K weight minus 32 at k past ko 0 (low bits) and ko 1 (high bits); pass p picks
note the nibble (p / 2) and the two high bits (2 p)
lo = and shr get rb add get ko 0 k mul shr p 1 4 15
hi = and shr get rb add get ko 1 k mul p 2 3
ret sub int or lo shl hi 4 32
end
fn dq6g s f32 p ulong to uint
note 16 weights sharing one scale (kd 4); activations at ac ko 2
a = s
xp = get ko 2
ds = get kd 4
for k ulong 16
q = q6v k p
a = add a mul mul ds f32 q get ac add xp k
end
ret bitcast uint a
end
fn dq6p s f32 to uint
note pass of a Q6_K block: 32 weights, two scales; kd 0 holds d; ko 3..6 hold the pass bases
a = s
for g ulong 2
put ko 0 add get ko 3 mul g 16
put ko 1 add get ko 4 mul g 16
put ko 2 add get ko 5 mul g 16
c = get rb add get ko 6 g
put kd 4 mul get kd 0 bitcast f32 i8f c
a = bitcast f32 dq6g a get ko 7
end
ret bitcast uint a
end
fn q6set o ulong xb ulong hf ulong p ulong to void
note bases of pass p of half hf: ko 3 low bits, ko 4 high bits, ko 5 activations, ko 6 scales, ko 7 p
put ko 3 add o mul hf 64
put ko 3 add get ko 3 mul and p 1 32
put ko 4 add add o 128 mul hf 32
put ko 5 add xb mul hf 128
put ko 5 add get ko 5 mul p 32
put ko 6 add add o 192 mul hf 8
put ko 6 add get ko 6 mul p 2
put ko 7 p
end
fn dq6b o ulong xb ulong to uint
note one Q6_K block (210 bytes at rb o) against 256 activations at ac xb, in index order
put kd 0 bitcast f32 f16 get rb add o 208 get rb add o 209
s = get cf KNZ
for hf ulong 2
for p ulong 4
q6set o xb hf p
s = bitcast f32 dq6p s
end
end
ret bitcast uint s
end
fn dq6 nb ulong xo ulong to uint
acc = f32 0.0
for b ulong nb
acc = add acc bitcast f32 dq6b mul b 210 add xo mul b 256
end
ret bitcast uint acc
end
fn dv6g p ulong to void
yp = get ko 2
ds = get kd 4
for k ulong 16
q = q6v k p
put ac add yp k mul ds f32 q
end
end
fn dv6 nb ulong yo ulong to void
note dequantize the Q6_K row in rb into ac at yo (the embedding lookup)
for b ulong nb
o = mul b 210
put kd 0 bitcast f32 f16 get rb add o 208 get rb add o 209
for hf ulong 2
for p ulong 4
q6set o add yo mul b 256 hf p
for g ulong 2
put ko 0 add get ko 3 mul g 16
put ko 1 add get ko 4 mul g 16
put ko 2 add get ko 5 mul g 16
c = get rb add get ko 6 g
put kd 4 mul get kd 0 bitcast f32 i8f c
dv6g p
end
end
end
end
end
