note ---- the forward pass (src/decode.rs) ----
fn rmsn xo ulong wo ulong yo ulong to void
ss = get cf KNZ
for i ulong NE
v = get ac add xo i
ss = add ss mul v v
end
ss = div ss 2048.0
sc = div 1.0 bitcast f32 msqrt add ss get cf KEPS
for i ulong NE
v = mul get ac add xo i sc
put ac add yo i mul v get nw add wo i
end
end
fn ropec pos ulong to void
ts = get cf KTS
th = f32 pos
for i ulong 32
sincos div th get rf i i
th = mul th ts
end
end
fn ropea o ulong nh ulong to void
for h ulong nh
for i ulong 32
j = add add o mul h 64 mul i 2
a = get ac j
b = get ac add j 1
c = get ac add ARC i
s = get ac add ARS i
put ac j sub mul a c mul b s
put ac add j 1 add mul a s mul b c
end
end
end
fn smax n ulong to void
mx = get cf KNINF
for t ulong n
mx = fmax mx get ac add ASC t
end
sm = f32 0.0
for t ulong n
v = bitcast f32 mexp sub get ac add ASC t mx
put ac add ASC t v
sm = add sm v
end
for t ulong n
put ac add ASC t div get ac add ASC t sm
end
end
fn ascore qo ulong kv ulong t ulong to uint
note q . k over one head (64 values), summed in order from -0.0
kq = add kv mul t KVD
s = get cf KNZ
for i ulong 64
v = mul get ac add qo i get kc add kq i
s = add s v
end
ret bitcast uint s
end
fn aacc ao ulong kv ulong t ulong to void
vo = add kv mul t KVD
w = get ac add ASC t
for i ulong 64
v = mul w get vc add vo i
put ac add ao i add get ac add ao i v
end
end
fn ahead base ulong np ulong h ulong to void
kv = add base mul div h 4 64
qo = add AQ mul h 64
for t ulong np
s = bitcast f32 ascore qo kv t
put ac add ASC t mul s get cf KSCALE
end
smax np
ao = add AAT mul h 64
for i ulong 64
put ac add ao i 0.0
end
for t ulong np
aacc ao kv t
end
end
fn attn l ulong pos ulong to void
base = mul l mul CTX KVD
for h ulong 32
ahead base add pos 1 h
end
end
fn resid to void
for i ulong NE
put ac add AX i add get ac add AX i get ac add AT i
end
end
fn kvst l ulong pos ulong to void
at = add mul l mul CTX KVD mul pos KVD
for i ulong KVD
put kc add at i get ac add AK i
put vc add at i get ac add AV i
end
end
fn silu to void
for i ulong NF
g = get ac add AG i
e = add 1.0 bitcast f32 mexp neg g
put ac add AG i mul div g e get ac add AU i
end
end
fn fwd tok ulong pos ulong want bool to void
rowcp add get tof 144 mul tok 1680 1680
put st SRB add get st SRB 1680
dv6 8 AX
ropec pos
for l ulong 16
rmsn AX mul l NE AH
li = mul l 9
mv li AH AQ 2048 2048
mv add li 1 AH AK 512 2048
mv add li 2 AH AV 512 2048
ropea AQ 32
ropea AK 8
kvst l pos
attn l pos
mv add li 3 AAT AT 2048 2048
resid
if and eq l 8 eq pos get st SFLT
trap 12
end
rmsn AX mul add 16 l NE AH
mv add li 6 AH AG 8192 2048
mv add li 7 AH AU 8192 2048
silu
mv add li 8 AG AT 2048 8192
resid
end
if want
rmsn AX mul 32 NE AH
mv 144 AH ALG NV 2048
end
end
fn amax to ulong
best = ulong 0
bv = get ac ALG
for i ulong NV
v = get ac add ALG i
if gt v bv
best = i
bv = v
end
end
ret best
end
note ---- load: read, digest, admit ----
fn loadf32 a ulong n ulong dst ulong to void
note n little-endian f32 values at file address a into nw at dst
for i ulong n
o = add a mul i 4
v = or or uint fb o shl uint fb add o 1 8 or shl uint fb add o 2 16 shl uint fb add o 3 24
put nw add dst i bitcast f32 v
end
end
fn admit to void
@@GEN_LOAD@@
x = pread int 3 one 0 1 long FSIZE
if ne x 0
refuse WSIZE
end
header
hreset
@@GEN_HASH@@
ok = hfinal
if not ok
refuse WSHA
end
for i ulong 64
if ne get hd i get sha i
refuse WSHA
end
end
for l ulong 16
loadf32 get tof add mul l 9 4 NE mul l NE
loadf32 get tof add mul l 9 5 NE mul add 16 l NE
end
loadf32 get tof 145 NE mul 32 NE
for i ulong 32
o = add get tof 146 mul i 4
v = or or uint fb o shl uint fb add o 1 8 or shl uint fb add o 2 16 shl uint fb add o 3 24
put rf i bitcast f32 v
end
initc
ow WLOAD
osp
ow WOK
osp
ow WBYTES
osp
ou FSIZE
osp
ow WTENS
osp
ou NTENS
osp
ow WSHA
osp
for i ulong 64
oc get hd i
end
osp
ow WPASSES
oc 32
oc 48
onl
end
note ---- requests ----
fn getln to long
note next request line in ib at st SLS; length, -1 at end of input, -2 for a line over the buffer
while true bound 999999
s = get st SSTART
f = get st SFILL
i = s
while lt i f bound 999999
if eq get ib i 10
put st SSTART add i 1
if eq get st SSKIP 1
put st SSKIP 0
ret long -2
end
put st SLS s
ret long sub i s
end
i = add i 1
end
if eq get st SEOF 1
if lt s f
put st SSTART f
if eq get st SSKIP 1
put st SSKIP 0
ret long -2
end
put st SLS s
ret long sub f s
end
if eq get st SSKIP 1
put st SSKIP 0
ret long -2
end
ret long -1
end
n = sub f s
for j ulong n
put ib j get ib add s j
end
if eq n IBCAP
n = ulong 0
put st SSKIP 1
end
put st SSTART 0
put st SFILL n
r = read int 0 ib n sub IBCAP n
if le r 0
put st SEOF 1
else
put st SFILL add n ulong r
end
end
ret long -1
end
fn tword k ulong to bool
note the request word k at the cursor, then a space or the line end; the cursor moves past the word
p = get st SPC
e = get st SPE
n = ulong 0
for i ulong 16
c = get tw add mul k 16 i
if eq c 32
break
end
n = add n 1
end
if gt add p n e
ret false
end
for i ulong n
if ne get ib add p i get tw add mul k 16 i
ret false
end
end
q = add p n
if lt q e
if ne get ib q 32
ret false
end
end
put st SPC q
ret true
end
fn tsp to bool
note exactly one space, then more text
p = get st SPC
e = get st SPE
if ge add p 1 e
ret false
end
if ne get ib p 32
ret false
end
if eq get ib add p 1 32
ret false
end
put st SPC add p 1
ret true
end
fn tnum to ulong
note a decimal number of 1..18 digits; anything else sets st SERR
p = get st SPC
e = get st SPE
v = ulong 0
n = ulong 0
while lt p e bound 100
c = get ib p
if eq c 32
break
end
if or lt c 48 gt c 57
put st SERR 1
ret 0
end
v = add mul v 10 ulong sub c 48
n = add n 1
if gt n 18
put st SERR 1
ret 0
end
p = add p 1
end
if eq n 0
put st SERR 1
end
put st SPC p
ret v
end
fn oid to void
n = get st SIDN
if eq n 0
ow WQMARK
ret
end
s = get st SIDS
for i ulong n
oc get ib add s i
end
end
fn jref w ulong to void
put st SOB 0
ow WJOB
osp
oid
osp
ow WSTATUS
osp
ow WREFUSED
osp
ow WREASON
osp
ow w
onl
end
fn tfield k ulong to ulong
note " <word k> <number>"; a failure sets st SERR
if not tsp
put st SERR 1
ret 0
end
if not tword k
put st SERR 1
ret 0
end
if not tsp
put st SERR 1
ret 0
end
ret tnum
end
fn pid to bool
note the job id: 1..32 printable bytes up to the next space
p = get st SPC
e = get st SPE
q = p
while lt q e bound 100
c = get ib q
if eq c 32
break
end
if or lt c 33 gt c 126
ret false
end
q = add q 1
end
if gt sub q p 32
ret false
end
put st SIDS p
put st SIDN sub q p
put st SPC q
ret true
end
fn pids to ulong
note " <id>" repeated to the line end into ids; returns the count or a refusal word plus 1000
k = ulong 0
while lt get st SPC get st SPE bound 100000
if not tsp
ret add WSYNTAX 1000
end
v = tnum
if eq get st SERR 1
ret add WSYNTAX 1000
end
if ge k CTX
ret add WTOOMANY 1000
end
if ge v NV
ret add WBADID 1000
end
put ids k v
k = add k 1
end
ret k
end
fn parse ls ulong n ulong to ulong
note fills SIDS SIDN SGEN SBUD SSTOP SFAULT SNID and ids; returns 99 when accepted, else a refusal word
put st SPC ls
put st SPE add ls n
put st SERR 0
put st SIDN 0
if not tword WJOB
ret WSYNTAX
end
if not tsp
ret WSYNTAX
end
if not pid
ret WSYNTAX
end
put st SGEN tfield WGEN
put st SBUD tfield WBUDGET
put st SSTOP tfield WSTOP
put st SFAULT tfield WFAULT
if eq get st SERR 1
ret WSYNTAX
end
if not tsp
ret WSYNTAX
end
if not tword WIDS
ret WSYNTAX
end
k = pids
if ge k 1000
ret sub k 1000
end
if eq k 0
ret WEMPTY
end
if or eq get st SGEN 0 gt get st SFAULT 1
ret WRANGE
end
if gt sub add k get st SGEN 1 CTX
ret WCONTEXT
end
put st SNID k
ret 99
end
fn tpush t ulong to void
nt = get st SNTOK
put tk nt t
put tb nt ulong bitcast uint get ac add ALG t
put st SNTOK add nt 1
end
fn jrun to ulong
note prefill then greedy steps; returns the passes run; st SCAN 1 when the budget ran out
n = get st SNID
bud = get st SBUD
put st SRB 0
put st SCAN 0
put st SNTOK 0
put st SFLT 4294967295
if eq get st SFAULT 1
put st SFLT div n 2
end
pos = ulong 0
for i ulong n
if ge pos bud
put st SCAN 1
ret pos
end
fwd get ids i pos eq add i 1 n
pos = add pos 1
end
for s ulong get st SGEN
t = amax
tpush t
if eq t get st SSTOP
ret pos
end
if eq add s 1 get st SGEN
ret pos
end
if ge pos bud
put st SCAN 1
ret pos
end
fwd t pos true
pos = add pos 1
end
ret pos
end
fn kvclr pos ulong to void
note discard this job's KV state (the weights stay resident)
for l ulong 16
for p ulong pos
at = add mul l mul CTX KVD mul p KVD
for i ulong KVD
put kc add at i 0.0
put vc add at i 0.0
end
end
end
end
fn jout pos ulong to void
nt = get st SNTOK
put st SOB 0
ow WJOB
osp
oid
osp
ow WSTATUS
osp
if eq get st SCAN 1
ow WCANCEL
else
ow WOK
end
osp
ow WPASSES
osp
ou pos
osp
ow WTOKENS
for i ulong nt
osp
ou get tk i
end
onl
ow WBITS
for i ulong nt
osp
ou get tb i
end
onl
ow WACCT
osp
ow WJOB
osp
oid
osp
ow WROWB
osp
ou get st SRB
osp
ow WPASSES
osp
ou pos
onl
end
fn runjob to void
pos = jrun
kvclr pos
jout pos
end
fn main to int
admit
while true bound 999999
n = getln
if eq n -1
ret 0
end
if eq n -2
put st SIDN 0
jref WTOOLONG
continue
end
if eq n 0
continue
end
w = parse get st SLS ulong n
if ne w 99
jref w
continue
end
runjob
end
ret 0
end
