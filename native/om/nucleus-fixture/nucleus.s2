  ldr.x x0 x28 14
  add.x.i x0 x0 1
  str.x x0 x28 14
  mrs.elr x0
  str.x x0 x28 39
  str.x xzr x28 38
  str.x xzr x28 37
  movz.x x23 2 0
  movz.x x24 0 0
  movz.x x25 0 0
  b ENDRUN
; buffer checks: x1 = address, x2 = length; x7 = 0 when the whole range is the program's (CHKW: data only)
:CHKW
  movz.x x7 0 0
  cbz.x x2 CHKOK
  movz.x x10 0x4000 1
  cmp.x x2 x10
  b.hi CHKBAD
  ldr.x x12 x28 36
  cbz.x x12 CHKBAD
  ldr.x x10 x28 6
  ldr.x x11 x28 7
  cmp.x x1 x10
  b.lo CHKBAD
  add.x x11 x11 x10
  cmp.x x1 x11
  b.hs CHKBAD
  add.x x13 x1 x2
  cmp.x x13 x11
  b.hi CHKBAD
:CHKOK
  ret
:CHKBAD
  movz.x x7 1 0
  ret
:CHKR
  movz.x x7 0 0
  cbz.x x2 CHKOK
  movz.x x10 0x4000 1
  cmp.x x2 x10
  b.hi CHKBAD
  ldr.x x10 x28 10
  ldr.x x11 x28 11
  add.x x11 x11 x10
  cmp.x x1 x10
  b.lo CHKW
  cmp.x x1 x11
  b.hs CHKW
  add.x x13 x1 x2
  cmp.x x13 x11
  b.ls CHKOK
  b CHKW
; ---- ENDRUN: x23 reason (0 exit, 1 fault, 2 deadline), x24 status, x25 exception class ----
:ENDRUN
  movz.x x0 0 0
  msr.cntv_ctl x0
  isb
  mrs.cntvct x0
  ldr.x x1 x28 17
  sub.x x26 x0 x1
  bl NLB
  adr x21 S_RUN
  bl PSTR
  ldr.x x0 x28 12
  bl PDEC
  adr x21 S_END
  bl PSTR
