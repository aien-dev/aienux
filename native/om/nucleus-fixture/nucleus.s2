  ldr.x x1 x28 16
  sub.x x26 x0 x1
  bl NLB
  adr x21 S_HALT
  bl PSTR
  ldr.x x0 x28 12
  bl PDEC
  adr x21 S_FAULTS
  bl PSTR
  ldr.x x0 x28 13
  bl PDEC
  adr x21 S_DEADLS
  bl PSTR
  ldr.x x0 x28 14
  bl PDEC
  adr x21 S_TICKS
  bl PSTR
  mov.x x0 x26
  bl PDEC
  bl NLE
  b HALTLOOP
; ---- console: PL011 at 0x09000000 (DR +0x00, FR +0x18, TXFF = FR bit 5) ----
:PUTC
