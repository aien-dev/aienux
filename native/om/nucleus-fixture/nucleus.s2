  ldr.x.post x30 sp 16
  ret
:PSTR
  str.x.pre x30 sp -16
:PSTRL
  ldrb.post x0 x21 1
  cbz.w x0 PSTRE
  bl PUTC
  b PSTRL
:PSTRE
  ldr.x.post x30 sp 16
  ret
; PDEC: ' ' then x0 in decimal (number buffer = vars 29..32, ends at V+264)
:PDEC
