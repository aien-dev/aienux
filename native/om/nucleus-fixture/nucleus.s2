  adr x21 S_STATUS
  bl PSTR
  mov.x x0 x24
  bl PDEC
  adr x21 S_EC
  bl PSTR
  mov.x x0 x25
  bl PDEC
  adr x21 S_FAR
  bl PSTR
  ldr.x x0 x28 38
  bl PDEC
  adr x21 S_ELR
  bl PSTR
  ldr.x x0 x28 39
  bl PDEC
  adr x21 S_TICKS
  bl PSTR
  mov.x x0 x26
  bl PDEC
  adr x21 S_SVC
  bl PSTR
  ldr.x x0 x28 18
  bl PDEC
  ldr.x x0 x28 19
  bl PDEC
  ldr.x x0 x28 20
  bl PDEC
  ldr.x x0 x28 21
  bl PDEC
  ldr.x x0 x28 22
  bl PDEC
