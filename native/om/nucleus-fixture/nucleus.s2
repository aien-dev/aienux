  cbnz.x x7 EFAULT
  ldr.x x4 x28 3
  movz.x x0 0 0
  cmp.x x3 x4
  b.hs SRET
  sub.x x5 x4 x3
  cmp.x x2 x5
  b.ls SP1
  mov.x x2 x5
:SP1
  movz.x x6 1 2
  movk.x x6 0x4000 1
  add.x x6 x6 x3
  mov.x x0 x2
  orr.x x7 x6 x1
  orr.x x7 x7 x2
  and.x.bm x7 x7 1 0 2
  movz.x x9 0 0
  cbnz.x x7 SPBL
:SPQ
  cmp.x x9 x2
  b.hs SPD
  ldr.x.post x10 x6 8
  str.x.post x10 x1 8
  add.x.i x9 x9 8
  b SPQ
:SPBL
  cmp.x x9 x2
  b.hs SPD
  ldrb.r x10 x6 x9
  strb.r x10 x1 x9
  add.x.i x9 x9 1
  b SPBL
:SPD
  ldr.x x9 x28 25
  add.x x9 x9 x0
  str.x x9 x28 25
  b SRET
:SEXIT
  ldr.x x9 x28 21
  add.x.i x9 x9 1
  str.x x9 x28 21
  ubfm.x x24 x0 0 7
  str.x x24 x28 27
  str.x xzr x28 37
  str.x xzr x28 38
  str.x xzr x28 39
  movz.x x23 0 0
  movz.x x25 0 0
  b ENDRUN
:EL0FAULT
  str.x x2 x28 37
  mrs.far x0
  str.x x0 x28 38
  mrs.elr x0
  str.x x0 x28 39
  ldr.x x0 x28 13
  add.x.i x0 x0 1
  str.x x0 x28 13
  movz.x x23 1 0
  movz.x x24 0 0
  mov.x x25 x2
  b ENDRUN
:EL0IRQ
  mrs.icc_iar1 x1
  ubfm.x x2 x1 0 23
  cmp.x.i x2 27
  b.eq IRQT
  movz.x x3 1023 0
  cmp.x x2 x3
  b.eq RESUME
