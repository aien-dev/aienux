  b.hs RLD
  cmp.x x0 x5
  b.hs RLD
  ldrb.r x7 x6 x0
  strb.r x7 x1 x0
  add.x.i x0 x0 1
  cmp.x.i x7 10
  b.ne RL
:RLD
  add.x x4 x4 x0
  str.x x4 x28 2
  ldr.x x9 x28 23
  add.x x9 x9 x0
  str.x x9 x28 23
  ldr.x x9 x28 4
  cbz.x x9 SRET
  msr.cntv_tval x9
  movz.x x9 1 0
  msr.cntv_ctl x9
  isb
  b SRET
:REOF
  movz.x x9 0 0
  msr.cntv_ctl x9
  isb
  movz.x x0 0 0
  b SRET
; write(fd 1 or 2): bytes to the UART, ESC doubled
:SWRITE
  ldr.x x9 x28 19
  add.x.i x9 x9 1
  str.x x9 x28 19
  cmp.x.i x0 1
  b.eq SW1
  cmp.x.i x0 2
  b.ne EBADF
:SW1
  bl CHKR
  cbnz.x x7 EFAULT
  mov.x x4 x1
  mov.x x5 x2
  movz.x x6 0 0
:WL
