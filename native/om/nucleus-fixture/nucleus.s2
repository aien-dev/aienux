  movz.x x0 27 0
:WLP
  bl PUTC
  add.x.i x6 x6 1
  b WL
:WLD
  ldr.x x9 x28 24
  add.x x9 x9 x5
  str.x x9 x28 24
  mov.x x0 x5
  b SRET
; pread64(fd 3): bytes of the model region at an explicit position
:SPREAD
  ldr.x x9 x28 20
  add.x.i x9 x9 1
  str.x x9 x28 20
  cmp.x.i x0 3
  b.ne EBADF
  cmp.x.i x3 0
  b.lt EINVAL
