= msr.cntv_ctl 0xd51be320 r0  ; C6.2.289; CNTV_CTL_EL0 (3,3,14,3,1) D24.10.28
= mrs.curel    0xd5384240 r0  ; C6.2.287; CurrentEL (3,0,4,2,2) C5.2.2
= msr.tpidr1   0xd518d080 r0  ; C6.2.289; TPIDR_EL1 (3,0,13,0,4) D24.2.204
= mrs.tpidr1   0xd538d080 r0  ; C6.2.287; TPIDR_EL1
