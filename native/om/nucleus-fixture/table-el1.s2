; table-el1.s2 -- privileged (EL1) instruction lines for the arch#314 boot fixture, read after
; seed/rung2/table.s2, rung3/table3.s2, rung4/table4.s2 and atlas/table5.s2 of omega-mv. Same format.
; Fixed parts from Arm DDI 0487 M.d: MSR (register) C6.2.289 = 0xD51 | o0 op1 CRn CRm op2 | Rt,
; MRS C6.2.287 = 0xD53 | same fields (op0 = 2 + o0). Register coordinates (op0,op1,CRn,CRm,op2) from the
; register's own section, named on each line; GICv3 CPU interface registers from Arm IHI 0069H.b 12.2.
; Upstream input for L408 compiler prerequisite (c) (privileged words); not part of the seed chain.
= msr.vbar     0xd518c000 r0  ; C6.2.289; VBAR_EL1 (3,0,12,0,0) D24.2.213
= mrs.vbar     0xd538c000 r0  ; C6.2.287; VBAR_EL1
= msr.sctlr    0xd5181000 r0  ; C6.2.289; SCTLR_EL1 (3,0,1,0,0) D24.2.174
= mrs.sctlr    0xd5381000 r0  ; C6.2.287; SCTLR_EL1
= msr.tcr      0xd5182040 r0  ; C6.2.289; TCR_EL1 (3,0,2,0,2) D24.2.193
= msr.ttbr0    0xd5182000 r0  ; C6.2.289; TTBR0_EL1 (3,0,2,0,0) D24.2.208
= msr.mair     0xd518a200 r0  ; C6.2.289; MAIR_EL1 (3,0,10,2,0) D24.2.126
= msr.cpacr    0xd5181040 r0  ; C6.2.289; CPACR_EL1 (3,0,1,0,2) D24.2.35
= msr.elr      0xd5184020 r0  ; C6.2.289; ELR_EL1 (3,0,4,0,1) C5.2.5
= mrs.elr      0xd5384020 r0  ; C6.2.287; ELR_EL1
= msr.spsr     0xd5184000 r0  ; C6.2.289; SPSR_EL1 (3,0,4,0,0) C5.2.21
= mrs.spsr     0xd5384000 r0  ; C6.2.287; SPSR_EL1
