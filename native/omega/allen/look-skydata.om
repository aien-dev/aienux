text Sdgal "1794 11195 -30743 3732 3257 23970 16775162 9419 2207 -31306 1905 1255 58867 16644351 "
const SKNST ulong 1035
const SKNGAL ulong 2
global Skview long 14
global Skstar long 3105
global Skmag ulong 1035
global Skbv ulong 1035
global Skflux ulong 256
global Skpal ulong 384
global Skgal long 14
global Skrdy ulong 1
global Sdbuf uchar 65536
global Sdpos ulong 1
fn sdnext to long
p = get Sdpos 0
while eq get Sdbuf p 32 bound 64
p = add p 1
end
m = false
if eq get Sdbuf p 45
m = true
p = add p 1
end
v = long 0
b = ulong get Sdbuf p
while and ge b 48 le b 57 bound 20
v = add mul v 10 long sub b 48
p = add p 1
b = ulong get Sdbuf p
end
put Sdpos 0 p
if m
ret neg v
end
ret v
end
fn skdview to void
n = len Sdview
for i ulong n
put Sdbuf i get Sdview i
end
put Sdbuf n 0
put Sdpos 0 0
for i ulong 14
put Skview i sdnext
end
end
fn skdstars to void
n = len Sdstars
for i ulong n
put Sdbuf i get Sdstars i
end
put Sdbuf n 0
put Sdpos 0 0
for i ulong SKNST
j = mul i 3
put Skstar j sdnext
put Skstar add j 1 sdnext
put Skstar add j 2 sdnext
put Skmag i ulong sdnext
put Skbv i ulong sdnext
end
end
fn skdflux to void
n = len Sdflux
for i ulong n
put Sdbuf i get Sdflux i
end
put Sdbuf n 0
put Sdpos 0 0
for i ulong 256
put Skflux i ulong sdnext
end
end
fn skdpal to void
n = len Sdpal
for i ulong n
put Sdbuf i get Sdpal i
end
put Sdbuf n 0
put Sdpos 0 0
for i ulong 384
put Skpal i ulong sdnext
end
end
fn skdgal to void
n = len Sdgal
for i ulong n
put Sdbuf i get Sdgal i
end
put Sdbuf n 0
put Sdpos 0 0
for i ulong 14
put Skgal i sdnext
end
end
fn skinit to void
if ne get Skrdy 0 0
ret
end
put Skrdy 0 1
skdview
skdstars
skdflux
skdpal
skdgal
end
