note Certificate verifier fixtures. Build order: base.om vendor/sha256-core.om vendor/cert-sha384.om
note vendor/cert-p256.om tls-p384.om vendor/cert-root.om tls-cert.om tests/check.om tests/tls-cert.om.
note Public api.github.com chain observed by parent 2026-10-25 in /tmp/allen-imac-qualification/github-api-fullchain.txt
note through an OpenSSL TLS1.3 ChaCha20 handshake. Independent oracle: openssl verify -CAfile system Root E46
note -untrusted intermediate -purpose sslserver -verify_hostname api.github.com leaf: OK. Test-only bytes.
note Leaf DER SHA256 06e6a4a004329905d4a4e7c0d2c6ec7a632c56443f256424a43cc786951b3149.
note Intermediate DER SHA256 873f0ba80e3ac222656dfd04158cc15c2927d42d5d05f01dee4a47eb43a916df.
note Cross-signed Root E46 DER SHA256 ea6b89ed6907a209ff9188676fb164e7aced894b8996dfbe5ce5bbcc22de4ddd.
note Production code never reads these texts; trust comes from vendor/cert-root.om only.
note certsig positive uses the public intermediate key and its real ECDSA-SHA256 over leaf TBS.
text Tleaf ""
text Tint ""
text Tcross ""
text Tok1 "api.github.com"
text Tok2 "API.GitHub.COM"
text Tok3 "*.github.com"
text Tbad1 "*.*.github.com"
text Tbad2 "x.api.github.com"
text Tbad3 "github.com"
text Tbad4 "api.github.com."
text Tbad5 "a*.github.com"
text Tbad6 "api.github.co"
text Tutc1 "260230000000Z"
text Tgen1 "20491231235959Z"
text Tutc2 "2610251200000"
text Tutc3 "261025120000Z"
global Tpos ulong 1

fn thexb w ulong i ulong to uchar
if eq w 0
ret or shl cthexv get Tleaf mul i 2 4 cthexv get Tleaf add mul i 2 1
end
if eq w 1
ret or shl cthexv get Tint mul i 2 4 cthexv get Tint add mul i 2 1
end
ret or shl cthexv get Tcross mul i 2 4 cthexv get Tcross add mul i 2 1
end

fn tlen w ulong to ulong
if eq w 0
ret div len Tleaf 2
end
if eq w 1
ret div len Tint 2
end
ret div len Tcross 2
end

fn tbegin to void
for i ulong 65536
put Certbuf i 0
end
put Tpos 0 4
end

fn tentry w ulong to void
p = get Tpos 0
n = tlen w
put Certbuf p uchar and shr n 16 255
put Certbuf add p 1 uchar and shr n 8 255
put Certbuf add p 2 uchar and n 255
for i ulong n
put Certbuf add add p 3 i thexb w i
end
put Tpos 0 add add p 5 n
end

fn tend to void
e = get Tpos 0
n = sub e 4
put Certbuf 1 uchar and shr n 16 255
put Certbuf 2 uchar and shr n 8 255
put Certbuf 3 uchar and n 255
put Certlen 0 e
end

fn tchain to void
tbegin
tentry 0
tentry 1
tentry 2
tend
end

fn tkey to bool
ok = true
for i ulong 65
if ne get Certkey i thexb 0 add 224 i
ok = false
end
end
ret ok
end

note Synthetic DER/name bytes are placed at62000 after the fixture chain; ctdns sees only its range.
fn tdnsok w ulong to bool
n = ulong 0
if eq w 0
n = len Tok1
for i ulong n
put Certbuf add 62000 i get Tok1 i
end
end
if eq w 1
n = len Tok2
for i ulong n
put Certbuf add 62000 i get Tok2 i
end
end
if eq w 2
n = len Tok3
for i ulong n
put Certbuf add 62000 i get Tok3 i
end
end
ret ctdns 62000 add 62000 n
end

fn tdnsbad w ulong to bool
n = ulong 0
if eq w 0
n = len Tbad1
for i ulong n
put Certbuf add 62000 i get Tbad1 i
end
end
if eq w 1
n = len Tbad2
for i ulong n
put Certbuf add 62000 i get Tbad2 i
end
end
if eq w 2
n = len Tbad3
for i ulong n
put Certbuf add 62000 i get Tbad3 i
end
end
if eq w 3
n = len Tbad4
for i ulong n
put Certbuf add 62000 i get Tbad4 i
end
end
if eq w 4
n = len Tbad5
for i ulong n
put Certbuf add 62000 i get Tbad5 i
end
end
if eq w 5
n = len Tbad6
for i ulong n
put Certbuf add 62000 i get Tbad6 i
end
end
ret ctdns 62000 add 62000 n
end

fn tder a uchar b uchar c uchar to bool
put Certbuf 62000 a
put Certbuf 62001 b
put Certbuf 62002 c
put Certbuf 62003 0
put Certbuf 62004 0
ret ctder 62000 62005
end

fn ttime w ulong to bool
p = ulong 62002
n = ulong 13
put Certbuf 62000 23
if eq w 0
for i ulong 13
put Certbuf add p i get Tutc1 i
end
end
if eq w 1
put Certbuf 62000 24
n = 15
for i ulong 15
put Certbuf add p i get Tgen1 i
end
end
if eq w 2
for i ulong 13
put Certbuf add p i get Tutc2 i
end
end
if eq w 3
for i ulong 13
put Certbuf add p i get Tutc3 i
end
end
put Certbuf 62001 uchar n
if not cttime 62000 add p n
ret false
end
ret ne ctepoch 0
end

note Leaf parse-only mutants: the fixture leaf begins at Certbuf 7 and ends at 1017.
fn tmut at ulong v uchar to bool
tchain
put Certbuf add 7 at v
ret ctparse 0 7 1017
end

fn tsigmsg to void
for i ulong 920
put Certmsg i thexb 0 add 4 i
end
for j ulong 71
put Certsig j thexb 0 add 939 j
end
for k ulong 65
put Cleaf k thexb 1 add 296 k
end
end

fn main to int
put Certnow 0 1792929600
tchain
check certcheck 1
check tkey 2
check eq get Ccount 0 3 3
check not ctca 1 1 4
check ctca 1 0 5
tsigmsg
check certsig 920 71 6
put Certmsg 10 xor get Certmsg 10 1
check not certsig 920 71 7
put Certmsg 10 xor get Certmsg 10 1
check not certsig 920 71 8
certreset
tsigmsg
check not certsig 920 71 9
put Certnow 0 1788048000
tchain
check certcheck 10
put Certnow 0 1788047999
check not certcheck 11
put Certnow 0 1795823999
check certcheck 12
put Certnow 0 1795824000
check not certcheck 13
put Certnow 0 0
check not certcheck 14
put Certnow 0 1792929600
tbegin
tentry 0
tentry 1
tend
check certcheck 15
tbegin
tentry 0
tend
check not certcheck 16
tbegin
tentry 1
tentry 0
tend
check not certcheck 17
tbegin
tentry 1
tend
check not certcheck 18
tchain
put Certbuf 1016 xor get Certbuf 1016 1
check not certcheck 19
tchain
put Certbuf 22 xor get Certbuf 22 1
check not certcheck 20
tchain
put Certbuf 1888 xor get Certbuf 1888 1
check not certcheck 21
tchain
put Certbuf 1018 1
check not certcheck 22
tchain
put Certbuf 0 1
check not certcheck 23
tchain
put Certlen 0 add get Certlen 0 1
check not certcheck 24
tchain
put Certlen 0 61000
check not certcheck 25
tchain
put Certbuf 3 xor get Certbuf 3 1
check not certcheck 26
tchain
check ctparse 0 7 1017 27
check not tmut 336 35 28
check not tmut 367 127 29
check tmut 336 126 30
check not tmut 935 3 31
check not tmut 1 0 32
check tmut 911 110 33
check eq get Cm 18 0 34
tchain
put Certbuf 918 110
check not certcheck 35
check tdnsok 0 36
check tdnsok 1 37
check tdnsok 2 38
check not tdnsbad 0 39
check not tdnsbad 1 40
check not tdnsbad 2 41
check not tdnsbad 3 42
check not tdnsbad 4 43
check not tdnsbad 5 44
check not tder 48 128 0 45
check not tder 48 129 3 46
check not tder 31 1 0 47
check not tder 48 4 0 48
check tder 48 3 0 49
check not ttime 0 50
check not ttime 1 51
check not ttime 2 52
check ttime 3 53
put Certnow 0 253402300800
tchain
check not certcheck 54
put Certnow 0 1792929600
tchain
check certcheck 55
certreset
