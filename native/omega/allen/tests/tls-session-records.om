note Independent protocol construction per RFC8446 sections5,6; real AEAD, no substituted APIs.
note These isolate record/lifecycle logic with provisioned epoch keys, not certificate authentication.
global Vrec uchar 1024
global Vhold uchar 256
global Vn ulong 1
fn vreset to void
tsclear
put Tlsstate 0 2
put Tsctl 6 5
for i ulong 32
put Tskey add i 96 uchar i
put Tskey add i 64 uchar add i 64
end
for i ulong 12
put Tsiv add i 36 uchar add i 32
put Tsiv add i 24 uchar add i 48
end
end
note Encode server wire independently of tsseal/tsnonce; Tcbuf content supplied by fixture.
fn vrecord off ulong n ulong typ uchar seq ulong to bool
for i ulong 32
put Tckey i uchar i
end
for i ulong 12
put Tciv i uchar add i 32
end
for i ulong 8
p = sub ulong 11 i
b = uchar and shr seq mul i 8 255
put Tciv p xor get Tciv p b
end
put Tcbuf n typ
put Tcaad 0 23
put Tcaad 1 3
put Tcaad 2 3
put Tcaad 3 uchar shr add n 17 8
put Tcaad 4 uchar and add n 17 255
if not tcseal add n 1 5
ret false
end
for i ulong 5
put Vrec add off i get Tcaad i
end
for i ulong add n 1
put Vrec add add off 5 i get Tcbuf i
end
for i ulong 16
p = add add off n 6
put Vrec add p i get Tctag i
end
put Vn 0 add add off n 22
ret true
end
fn vfeed off ulong n ulong to void
for i ulong n
put Tlsin i get Vrec add off i
end
tlsinput n
end
fn vabc to void
put Tcbuf 0 97
put Tcbuf 1 98
put Tcbuf 2 99
end
fn main to int
vreset
vabc
if not vrecord 0 3 23 0
ret 1
end
for cut ulong 26
vreset
vfeed 0 cut
if lt cut 25
if ne get Tlsappn 0 0
ret 2
end
end
vfeed cut sub ulong 25 cut
if or ne get Tlsstate 0 2 ne get Tlsappn 0 3
ret 3
end
if or ne get Tlsapp 0 97 ne get Tlsapp 2 99
ret 4
end
tlsconsume 2
if or ne get Tlsappn 0 1 ne get Tlsapp 0 99
ret 5
end
if ne get Tlsapp 2 0
ret 6
end
end
note Coalesced records have independent sequence nonces and accumulate application data.
vreset
vabc
if not vrecord 0 3 23 0
ret 7
end
put Tcbuf 0 100
put Tcbuf 1 101
if not vrecord 25 2 23 1
ret 8
end
vfeed 0 get Vn 0
if or ne get Tlsappn 0 5 ne get Tlsapp 4 101
ret 9
end
note Tampered tag exposes no plaintext and wipes previously queued authenticated bytes too.
vreset
put Vrec 24 xor get Vrec 24 1
vfeed 0 25
if or ne get Tlsstate 0 4 ne get Tlsstate 1 6
ret 10
end
if ne get Tlsappn 0 0
ret 11
end
for i ulong 128
if ne get Tskey i 0
ret 12
end
end
note A fragmented handshake cannot be interleaved with application data.
vreset
put Tcbuf 0 4
put Tcbuf 1 0
if not vrecord 0 2 22 0
ret 13
end
vabc
if not vrecord 24 3 23 1
ret 14
end
vfeed 0 get Vn 0
if or ne get Tlsstate 0 4 ne get Tlsstate 1 5
ret 15
end
note Valid NewSessionTicket split across two records is discarded without resumption.
vreset
for i ulong 8
put Tcbuf i 0
end
put Tcbuf 0 4
put Tcbuf 3 14
put Tcbuf 7 1
if not vrecord 0 8 22 0
ret 16
end
for i ulong 10
put Tcbuf i 0
end
put Tcbuf 6 1
put Tcbuf 7 99
if not vrecord 30 10 22 1
ret 17
end
vabc
if not vrecord 62 3 23 2
ret 18
end
vfeed 0 get Vn 0
if or ne get Tlsstate 0 2 ne get Tlsappn 0 3
ret 19
end
if ne get Tsctl 1 0
ret 20
end
note KeyUpdate is explicitly refused, never interpreted under stale keys.
vreset
put Tcbuf 0 24
put Tcbuf 1 0
put Tcbuf 2 0
put Tcbuf 3 1
put Tcbuf 4 0
if not vrecord 0 5 22 0
ret 21
end
vfeed 0 get Vn 0
if or ne get Tlsstate 0 4 ne get Tlsstate 1 17
ret 22
end
note Inner zero padding is removed; an all-zero inner plaintext has no type and is refused.
vreset
vabc
put Tcbuf 3 23
put Tcbuf 4 0
if not vrecord 0 5 0 0
ret 33
end
vfeed 0 get Vn 0
if or ne get Tlsstate 0 2 ne get Tlsappn 0 3
ret 34
end
vreset
for i ulong 3
put Tcbuf i 0
end
if not vrecord 0 3 0 0
ret 35
end
vfeed 0 get Vn 0
if or ne get Tlsstate 0 4 ne get Tlsstate 1 5
ret 36
end
note Authenticated close_notify, unlike transport EOF, sets cleanClose and queues response.
vreset
put Tcbuf 0 1
put Tcbuf 1 0
if not vrecord 0 2 21 0
ret 23
end
vfeed 0 get Vn 0
if or ne get Tlsstate 0 3 ne get Tlsstate 2 1
ret 24
end
if ne get Tlsoutn 0 24
ret 25
end
note New writes and close requests do not overwrite an undelivered record.
vreset
put Tlsplain 0 65
if not tlswrite 1
ret 26
end
for i ulong get Tlsoutn 0
put Vhold i get Tlsout i
end
put Tlsplain 0 66
if tlswrite 1
ret 27
end
tlsclose
if ne get Tlsoutn 0 23
ret 28
end
for i ulong 23
if ne get Tlsout i get Vhold i
ret 29
end
end
tlssent
if or ne get Tlsoutn 0 24 ne get Tlsstate 2 0
ret 30
end
note Sequence use is refused before overflow; no nonce wraps.
vreset
put Tsseq 0 4294967295
if tlswrite 0
ret 31
end
if or ne get Tlsstate 0 4 ne get Tlsstate 1 13
ret 32
end
ret 0
end
