text Gxlist "[{\"id\":1427000265,\"full_name\":\"aien-dev/allen\",\"private\":false,\"owner\":{\"login\":\"aien-dev\",\"full_name\":\"x/y\"},\"created_at\":\"2026-10-20T12:35:09Z\"}]"
