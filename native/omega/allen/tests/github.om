fn gxmalformed to void
n = ulong 0
for i ulong len Gxbad
c = get Gxbad i
if eq c 10
gxfind
check ghreply 1 200 n get Ghreq 2 50
check eq get Gh 0 3 51
check eq get Gh 2 3 52
check eq get jcnt 0 0 53
n = 0
else
put Ghbody n c
n = add n 1
end
end
gxfind
for i ulong len Gxdup
put Ghbody i get Gxdup i
end
check ghreply 1 200 len Gxdup get Ghreq 2 54
check eq get Gh 0 3 55
gxfind
for i ulong len Gxwrong
put Ghbody i get Gxwrong i
end
check ghreply 1 200 len Gxwrong get Ghreq 2 56
check eq get Gh 0 3 57
gxfind
check ghreply 1 200 65537 get Ghreq 2 58
check eq get Gh 2 2 59
gxfind
for i ulong len Gxpre
put Ghbody i get Gxpre i
end
for i ulong 513
put Ghbody add len Gxpre i 65
end
for i ulong len Gxpost
put Ghbody add add len Gxpre 513 i get Gxpost i
end
n = add add len Gxpre 513 len Gxpost
check ghreply 1 200 n get Ghreq 2 60
check eq get Gh 0 3 61
end
