note This harness is first-party Omega. No fixture executes external code or substitutes runtime bytes.

fn tvcheck ok bool code int to void
if not ok
exit code
end
end

fn tvnib c uchar to uchar
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
tvcheck false 99
ret 0
end

fn tvbyte a uchar b uchar to uchar
ret or shl tvnib a 4 tvnib b
end

fn tvscrub to void
for i ulong 8
tvcheck eq get H i 0 91
tvcheck eq get Vv i 0 91
end
for i ulong 64
tvcheck eq get W i 0 91
tvcheck eq get Hb i 0 91
tvcheck eq get Tccblk i 0 92
end
for i ulong 32
tvcheck eq get Tchi i 0 91
tvcheck eq get Hash i 0 91
tvcheck eq get Tcxsc i 0 93
tvcheck eq get Tcxres i 0 93
tvcheck eq get Tcxt i 0 93
tvcheck eq get Tcmkey i 0 92
end
for i ulong 176
tvcheck eq get Tcxf i 0 93
end
for i ulong 16
tvcheck eq get Tccs i 0 92
tvcheck eq get Tccw i 0 92
tvcheck eq get Tcmblk i 0 92
tvcheck eq get Tcmtag i 0 92
end
for i ulong 10
tvcheck eq get Tcmr i 0 92
tvcheck eq get Tcmh i 0 92
tvcheck eq get Tcmt i 0 92
tvcheck eq get Tcmg i 0 92
end
tvcheck eq get Hs 0 0 91
tvcheck eq get Hs 1 0 91
end
