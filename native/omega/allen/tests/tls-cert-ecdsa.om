note Independent ECDSA oracle vectors for tls-p384.om and vendor/cert-p256.om.
note Build: base.om vendor/sha256-core.om vendor/cert-sha384.om vendor/cert-p256.om tls-p384.om tests/check.om tests/tls-cert-ecdsa.om
note Generated 2026-10-25 with OpenSSL: throwaway test-only keys from openssl ecparam -genkey (secp384r1, prime256v1),
note signatures from openssl dgst -sha384/-sha256 -sign, each accepted by openssl dgst -verify before embedding.
note Message lengths 0,1,55,111,112,127,128,129,239,1000 cross SHA-256/SHA-384 padding boundaries. No private key here.
note Record: public key 04||X||Y, r, s, n-s, message.
text Vdat ""

fn cthexb c uchar to uchar
if and ge c 48 le c 57
ret sub c 48
end
if and ge c 97 le c 102
ret sub c 87
end
trap 5
end

fn tvb i ulong to uchar
ret or shl cthexb get Vdat mul i 2 4 cthexb get Vdat add mul i 2 1
end

note mode 0 as signed, 1 message or digest bit flip, 2 r flip, 3 s flip, 4 public Y flip,
note 5 high-s n-s (valid ECDSA), 6 r zero, 7 s replaced by n (out of range).
fn tv384 off ulong ml ulong mode ulong to bool
w = new ulong 1536 0
b = new uchar 4096 0
so = add add off 97 48
if eq mode 5
so = add so 48
end
mo = add off 241
m = new uchar 65536 0
d = new uchar 64 0
for i ulong ml
put m i tvb add mo i
end
cs384hash m ml d
for j ulong 48
put b add 3296 j get d j
end
for k ulong 97
put b add 3072 k tvb add off k
end
for q ulong 48
put b add 3200 q tvb add add off 97 q
put b add 3248 q tvb add so q
end
if eq mode 1
put b 3296 xor get b 3296 1
end
if eq mode 2
put b 3247 xor get b 3247 1
end
if eq mode 3
put b 3295 xor get b 3295 1
end
if eq mode 4
put b 3168 xor get b 3168 1
end
if eq mode 6
for z ulong 48
put b add 3200 z 0
end
end
if eq mode 7
put b 3248 255
put b 3249 255
put b 3250 255
put b 3251 255
put b 3252 255
put b 3253 255
put b 3254 255
put b 3255 255
put b 3256 255
put b 3257 255
put b 3258 255
put b 3259 255
put b 3260 255
put b 3261 255
put b 3262 255
put b 3263 255
put b 3264 255
put b 3265 255
