put b 3289 236
put b 3290 25
put b 3291 106
put b 3292 204
put b 3293 197
put b 3294 41
put b 3295 115
end
cp3init w
ret eq cp3vrfy w b 1
end

note mode 0 as signed, 1 message or digest bit flip, 2 r flip, 3 s flip, 4 public Y flip,
note 5 high-s n-s (valid ECDSA), 6 r zero, 7 s replaced by n (out of range).
fn tv256 off ulong ml ulong mode ulong to bool
w = new ulong 1024 0
b = new uchar 4096 0
so = add add off 65 32
if eq mode 5
so = add so 32
end
mo = add off 161
constants
hinit
for i ulong ml
hbyte tvb add mo i
end
finish
for j ulong 32
put b add 3296 j get Hash j
end
for k ulong 65
put b add 3072 k tvb add off k
end
for q ulong 32
put b add 3200 q tvb add add off 65 q
put b add 3232 q tvb add so q
end
if eq mode 1
put b 3296 xor get b 3296 1
end
if eq mode 2
put b 3231 xor get b 3231 1
end
if eq mode 3
put b 3263 xor get b 3263 1
end
if eq mode 4
put b 3136 xor get b 3136 1
end
if eq mode 6
for z ulong 32
put b add 3200 z 0
end
end
if eq mode 7
put b 3232 255
put b 3233 255
put b 3234 255
put b 3235 255
put b 3236 0
put b 3237 0
put b 3238 0
put b 3239 0
put b 3240 255
put b 3241 255
put b 3242 255
put b 3243 255
put b 3244 255
put b 3245 255
