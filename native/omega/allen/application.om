note Native application binding: conversation state, courier lifecycle and reply/code.
note A initialized, queued AGAIN bytes, per-call event, reserved.
note Events:0 none,1 visible answer/ack,2 AGAIN queued,3 code give-up,
note 4 refused LINE payload,5 slow notice,6 silence timeout.
note Transport acceptance is separate from payload acceptance: appreceive true
note means envelope accepted; inspect A2 for malformed payload, never invent text.
global A ulong 4
global Appjob uchar 4096
global Appwire uchar 8192
global Askin uchar 160
fn appinit run ulong now ulong to bool
if or ne get A 0 0 ne get R 0 0
ret false
end
if ne get Q 0 0
ret false
end
if not qstart run now
ret false
end
constants
put A 0 1
put A 1 0
put A 2 0
ret true
end
fn appclock now ulong to bool
if eq get A 0 0
ret false
end
ret and ge now get T 0 ge now get R 4
end
fn appask now ulong to bool
if not appclock now
ret false
end
if or ne get R 1 0 ne get A 1 0
ret false
end
if or ne get T 10 0 ne get T 13 0
ret false
end
if and ne get T 5 0 eq get T 6 0
ret false
end
if or ge get R 0 4294967295 ge get Q 1 4294967295
ret false
end
if not textok
ret false
end
kind = classify
if or lt kind 1 gt kind 3
ret false
end
if and eq kind 3 eq get R 6 0
ret false
end
note Validate restored context before jobbuild reads its variable-layout names.
if not ctxmeta 6
ret false
end
if not jobbuild kind add get R 0 1
ret false
end
if not ctxappend
ret false
end
n = get Inlen 0
size = get Outlen 0
for i ulong n
put Askin i get In i
end
for i ulong size
put Appjob i get Outb i
end
for i ulong size
put In i get Appjob i
end
put Inlen 0 size
queued = qsubmit now
for i ulong n
put In i get Askin i
end
put Inlen 0 n
if not queued
ret false
end
note start preconditions were checked before qsubmit; no concurrent calls permitted.
if not start kind now
qcancel
ret false
end
put A 2 0
if gt kind 1
codebeg get R 0
put A 2 1
end
ret true
end
fn appcancel to void
cancel
qcancel
put A 1 0
put A 2 0
end
fn appreset to void
appcancel
reset
end
note First acknowledge the triggering LINE, then submit AGAIN with a new wire
note sequence while retaining the original conversation ID in its body.
fn appqueue now ulong to bool
if eq get A 1 0
ret true
end
if or ne get T 10 0 ne get T 13 0
ret true
end
put Inlen 0 get A 1
for i ulong get A 1
put In i get Appjob i
end
if not qsubmit now
ret false
end
put A 1 0
ret true
end
fn apppoll now ulong online bool to bool
if not appclock now
ret false
end
put A 2 0
put T 0 now
status = tick now
if eq status 1
put A 2 5
end
if eq status 2
qcancel
put A 1 0
put A 2 6
end
if not appqueue now
appcancel
put A 2 3
ret false
end
ret qnext now online
end
fn appsent now ulong ok bool to bool
if not appclock now
ret false
end
if not qsent now ok
ret false
end
put A 2 0
ret true
end
fn appbody now ulong to bool
if eq get R 1 0
put A 2 4
ret true
end
if ineq 0 67
if or le get R 2 1 ne get C 0 get R 0
put A 2 4
ret true
end
if codetake
if heard get C 0 now
ret true
end
end
put A 2 4
ret true
end
if or ineq 0 83 ineq 0 87
status = saytake now
if eq status 1
if eq get R 1 0
put A 1 0
end
if ne get S 1 0
put A 2 1
end
ret true
end
if eq status 2
n = get Outlen 0
if or eq n 0 gt n 4096
cancel
put A 1 0
put A 2 3
ret true
end
for i ulong n
put Appjob i get Outb i
end
put A 1 n
put A 2 2
ret true
end
if eq status 3
put A 1 0
put A 2 3
ret true
end
end
put A 2 4
ret true
end
note Reply parsing can serialize AGAIN internally. Preserve the already offered
note datagram until the provider records its send result, including on refusal.
fn appreceive now ulong to bool
if not appclock now
ret false
end
result = qincoming now
if eq result 0
ret false
end
put A 2 0
if not qtake
ret true
end
n = get Outlen 0
e = get Err 0
for i ulong n
put Appwire i get Outb i
end
ok = appbody now
for i ulong n
put Outb i get Appwire i
end
put Outlen 0 n
put Err 0 e
ret ok
end
