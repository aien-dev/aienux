5 4056 4056 4057 4057 4058 4058 4058 4059 4059 4060 4060 4061 4061 4062 4062 4062 4063 4063 4064 4064 4065 4065 4066 4066 4066 4067 4067 4068 4068 4069 4069 4069 4070 4070 4071 4071 4072 4072 4073 4073 4073 4074 4074 4075 4075 4076 4076 4076 4077 4077 4078 4078 4079 4079 4080 4080 "
fn pkmin a long b long to long
if lt a b
ret a
end
ret b
end
fn pkmax a long b long to long
if gt a b
ret a
end
ret b
end
fn pkabs a long to long
if lt a 0
ret neg a
end
ret a
end
fn pkclamp v long lo long hi long to long
if lt v lo
ret lo
end
if gt v hi
ret hi
end
ret v
end
fn pkinitsin to void
note sine: a rotation by a 4096th of a turn, applied over and over (Q30)
c = long 1073741824
s = long 0
for k ulong 1025
v = shr add s 32768 16
if eq k 1024
v = 16384
end
put Psin k v
put Psin sub 2048 k v
put Psin and add 2048 k 4095 neg v
put Psin and sub 4096 k 4095 neg v
nc = shr sub mul c 1073740561 mul s 1647099 30
ns = shr add mul s 1073740561 mul c 1647099 30
c = nc
s = ns
end
put Psin 4096 get Psin 0
end
fn pkinitexp to void
note exp(-k/256): one factor of exp(-1/256) (Q30) per step
e = ulong 1073741824
for k ulong 4096
put Pexp k shr add e 8192 14
e = shr mul e 1069555701 30
end
end
fn pkinitlog to void
note log2(1 + k/256): square the value 16 times, taking a bit each time it passes 2
for k ulong 257
if eq k 256
put Plog k 65536
else
y = shl add ulong 256 k 8
r = ulong 0
for i ulong 16
b = sub ulong 15 i
y = shr mul y y 16
if ge y 131072
y = shr y 1
r = or r shl ulong 1 b
end
end
put Plog k r
end
end
end
fn pkinitatan to void
put Patan 0 8192
put Patan 1 4836
put Patan 2 2555
put Patan 3 1297
put Patan 4 651
put Patan 5 326
put Patan 6 163
put Patan 7 81
put Patan 8 41
put Patan 9 20
put Patan 10 10
put Patan 11 5
put Patan 12 3
put Patan 13 1
end
fn pkinitlin to void
v = ulong 0
slot = ulong 0
for i ulong len Plin
c = get Plin i
if eq c 32
put Slin slot ushort v
slot = add slot 1
v = 0
else
v = add mul v 10 sub ulong c 48
end
end
end
fn pkinitsrgb to void
v = ulong 0
slot = ulong 0
for i ulong len Psrgb
c = get Psrgb i
if eq c 32
put Ssrgb slot ushort v
slot = add slot 1
v = 0
else
v = add mul v 10 sub ulong c 48
end
end
end
fn pkinit to void
for i ulong 3
put Pgc i 0
end
for i ulong 514
put Pgt i 0
end
pkinitsin
pkinitexp
pkinitlog
pkinitatan
pkinitlin
pkinitsrgb
end
fn pksin a ulong to long
a = and a 65535
i = shr a 4
f = long and a 15
s0 = get Psin i
ret add s0 shr mul sub get Psin add i 1 s0 f 4
end
fn pkcos a ulong to long
ret pksin add a 16384
end
fn pkatan2 y long x long to ulong
if and eq x 0 eq y 0
ret 0
end
xx = x
yy = y
ang = ulong 0
if lt xx 0
xx = neg xx
yy = neg yy
ang = 32768
end
m = pkmax xx pkabs yy
while lt m 1048576
xx = mul xx 2
yy = mul yy 2
m = mul m 2
end
while ge m 4194304
xx = shr xx 1
yy = shr yy 1
m = shr m 1
end
z = long 0
for i ulong 14
st = long get Patan i
nx = xx
if gt yy 0
nx = add xx shr yy i
yy = sub yy shr xx i
z = add z st
else
nx = sub xx shr yy i
yy = add yy shr xx i
z = sub z st
end
xx = nx
end
ret and add ang bitcast ulong z 65535
end
fn pkexpneg x ulong to ulong
if lt x 4096
ret get Pexp x
end
ret 0
end
fn pklog2q16 v ulong to ulong
if eq v 0
ret 0
end
n = ulong 0
t = v
while ge t 2 bound 64
t = shr t 1
n = add n 1
end
m = v
if ge n 16
m = shr v sub n 16
else
m = shl v sub 16 n
end
k = and shr m 8 255
f = and m 255
lk = get Plog k
ret add add mul n 65536 lk shr mul sub get Plog add k 1 lk f 8
end
fn pkisqrt v ulong to ulong
ret afsqrt v
end
fn pkbits32 v long to ulong
ret and bitcast ulong v 4294967295
end
fn pkhash x long y long seed ulong to ulong
m = ulong 4294967295
a = and mul pkbits32 x 2376512323 m
b = and mul pkbits32 y 3625334849 m
c = and mul and seed m 3407524639 m
h = xor xor a b c
h = xor h shr h 13
h = and mul h 1540483477 m
h = xor h shr h 15
h = and mul h 668265261 m
h = xor h shr h 16
ret h
end
fn pksmooth t long to ulong
t = pkclamp t 0 256
ret ulong shr mul mul t t sub 768 mul 2 t 16
end
fn pkeaseout t long to ulong
u = sub 256 pkclamp t 0 256
ret sub ulong 256 ulong shr mul mul u u u 16
end
fn pkprog now ulong from ulong upto ulong to long
if le now from
ret 0
end
if ge now upto
ret 256
end
ret long div mul sub now from 256 sub upto from
end
fn pknrow ix long iy long seed ulong fx ulong to ulong
a = mul shr pkhash ix iy seed 16 sub 256 fx
ret add a mul shr pkhash add ix 1 iy seed 16 fx
end
fn pknoise x long y long seed ulong to ulong
fx = pksmooth long and pkbits32 x 255
fy = pksmooth long and pkbits32 y 255
ix = shr x 8
iy = shr y 8
a = pknrow ix iy seed fx
b = pknrow ix add iy 1 seed fx
ret shr add mul a sub 256 fy mul b fy 16
end
fn pkfbm x long y long seed ulong octaves ulong to ulong
sum = ulong 0
total = ulong 0
for o ulong octaves
w = shl ulong 1 sub sub octaves 1 o
sd = and add seed mul o 7919 4294967295
sum = add sum mul pknoise shl x o shl y o sd w
total = add total w
end
ret div sum total
end
fn pklenc light ulong to ulong
i = shr light 3
if ge light 32767
i = 4095
end
ret shr add ulong get Ssrgb i 8 4
end
fn pkscale c ulong f ulong to ulong
if eq f 0
ret 0
end
if ge f 256
ret c
end
out = ulong 0
s = ulong 16
for k ulong 3
x = and shr c s 255
x = pklenc shr mul ulong get Slin x f 8
out = or out shl x s
s = sub s 8
end
ret out
end
fn pkadd d ulong c ulong a ulong to ulong
if or eq a 0 eq c 0
ret d
end
if and eq d 0 eq a 256
ret c
end
out = ulong 0
s = ulong 16
for k ulong 3
x = and shr d s 255
y = and shr c s 255
v = shr mul ulong get Slin y a 8
if ne v 0
v = add ulong get Slin x v
i = shr v 3
if ge v 32767
i = 4095
end
x = shr add ulong get Ssrgb i 8 4
end
out = or out shl x s
s = sub s 8
end
ret out
end
fn pkmix d ulong c ulong a ulong to ulong
if or eq a 0 eq d c
ret d
end
if ge a 256
ret c
end
out = ulong 0
s = ulong 16
for k ulong 3
x = and shr d s 255
y = and shr c s 255
if ne x y
v = mul ulong get Slin x sub 256 a
v = shr add v mul ulong get Slin y a 8
i = shr v 3
if ge v 32767
i = 4095
end
x = shr add ulong get Ssrgb i 8 4
end
out = or out shl x s
s = sub s 8
end
ret out
end
fn pkcover d16 long to ulong
v = sub 8 d16
if le v 0
ret 0
end
if ge v 16
ret 256
end
ret ulong mul v 16
end
fn pkclip x long y long w long h long to void
x0 = pkmax x 0
y0 = pkmax y 0
x1 = pkmin add x w get Lg 0
y1 = pkmin add y h get Lg 1
put Lg 5 x0
put Lg 6 y0
put Lg 7 pkmax sub x1 x0 0
put Lg 8 pkmax sub y1 y0 0
end
fn pkfit x long y long w long h long to bool
note Ps[28..31] = the part of (x,y,w,h) inside the clip and the screen, as x0 y0 x1 y1; false when empty
x0 = pkmax x pkmax get Lg 5 0
y0 = pkmax y pkmax get Lg 6 0
x1 = add get Lg 5 get Lg 7
x1 = pkmin x1 get Lg 0
x1 = pkmin add x w x1
y1 = add get Lg 6 get Lg 8
y1 = pkmin y1 get Lg 1
y1 = pkmin add y h y1
put Ps 28 x0
put Ps 29 y0
put Ps 30 x1
put Ps 31 y1
if or le x1 x0 le y1 y0
ret false
end
ret true
end
fn pkmeets x long y long w long h long to bool
x0 = pkmax x get Lg 5
y0 = pkmax y get Lg 6
x1 = pkmin add x w add get Lg 5 get Lg 7
y1 = pkmin add y h add get Lg 6 get Lg 8
if or le x1 x0 le y1 y0
ret false
end
ret true
end
fn pkplot x long y long color ulong a ulong to void
if eq a 0
ret
end
lx = get Lg 5
ly = get Lg 6
if or lt x lx lt y ly
ret
end
if ge x add lx get Lg 7
ret
end
if ge y add ly get Lg 8
ret
end
if or lt x 0 lt y 0
ret
end
if ge x get Lg 0
ret
end
if ge y get Lg 1
ret
end
i = ulong add mul y get Lg 0 x
put Nfrm i uint pkadd ulong get Nfrm i color a
end
fn pkblend i ulong color ulong w ulong to void
note frame pixel i gets color's light times w/256 added (no clip test: callers fit first)
put Nfrm i uint pkadd ulong get Nfrm i color w
end
fn pkglowrow xa long xb long to void
note Ps: 0 cx, 2 r2, 3 inv, 4 color, 5 a, 10 y * width, 11 dy*dy
for i ulong ulong add sub xb xa 1
x = add xa long i
dx = add mul x 16 8
dx = sub dx get Ps 0
dx = add mul dx dx get Ps 11
if lt dx get Ps 2
f = shr mul dx get Ps 3 32
f = sub 256 f
f = shr mul shr mul f f 8 f 8
f = shr mul f get Ps 5 8
x = add get Ps 10 x
if eq get Nfrm x 0
f = add f long get Pgc 2
put Nfrm x uint get Pgt ulong f
else
dx = get Ps 4
pkblend ulong x ulong dx ulong f
end
end
end
end
note pkglowtab: the glow's colour over one black for every weight, kept for the last two
note colours (two alternate at the merger): most of the sky is one black, so the row's add
note becomes a table read; the bytes are pkadd's. Pgc: colour of table 0, of table 1, current.
fn pkglowtab color ulong to void
if eq get Pgc 0 color
put Pgc 2 0
ret
end
if eq get Pgc 1 color
put Pgc 2 257
ret
end
k = ulong 257
if eq get Pgc 2 257
k = 0
end
put Pgc 2 k
put Pgc div k 257 color
for i ulong 257
put Pgt add k i pkadd 0 color i
end
end
fn pkglowy y long to void
dy = add mul y 16 8
dy = sub dy get Ps 1
dy = mul dy dy
if lt dy get Ps 2
put Ps 11 dy
put Ps 10 mul y get Lg 0
dy = sub get Ps 2 dy
half = long pkisqrt ulong dy
xa = sub get Ps 0 half
xa = pkmax get Ps 6 shr xa 4
xb = add get Ps 0 half
xb = pkmin get Ps 7 shr xb 4
if le xa xb
pkglowrow xa xb
end
end
end
fn pkglow cx long cy long r long color ulong a ulong to void
if or le r 0 eq a 0
ret
end
x0 = shr sub cx r 4
y0 = shr sub cy r 4
if not pkfit x0 y0 add sub shr add cx r 4 x0 1 add sub shr add cy r 4 y0 1
ret
end
put Ps 0 cx
put Ps 1 cy
put Ps 2 mul r r
put Ps 3 div 1099511627776 mul r r
put Ps 4 long color
put Ps 5 long a
put Ps 6 get Ps 28
put Ps 7 sub get Ps 30 1
pkglowtab color
y0 = get Ps 29
for j ulong ulong sub get Ps 31 y0
pkglowy add y0 long j
end
end
fn pkthreadpx xc long yy long to void
note Ps: 12 color, 17 radius, 18 steep, 19 yc (16ths), 27 a
d = add mul yy 16 8
d = sub d get Ps 19
d = sub pkabs d get Ps 17
cov = pkcover d
cov = shr mul ulong get Ps 27 cov 8
color = ulong get Ps 12
if eq get Ps 18 1
pkplot yy xc color cov
else
pkplot xc yy color cov
end
end
fn pkthreadcol xc long to void
note one column (row when steep) at major coordinate xc; Ps: 8 x0, 9 y0, 13 a0, 14 a1, 15 len, 16 grad
along = add mul xc 16 8
along = sub along get Ps 8
yc = shr mul along get Ps 16 16
yc = add yc get Ps 9
put Ps 19 yc
a = sub get Ps 14 get Ps 13
a = div mul a along get Ps 15
put Ps 27 add a get Ps 13
ya = sub yc get Ps 17
ya = shr sub ya 8 4
yb = add yc get Ps 17
yb = shr add yb 8 4
for j ulong ulong add sub yb ya 1
pkthreadpx xc add ya long j
end
end
fn pkthreadgo to void
x0 = get Ps 8
x1 = get Ps 10
ln = sub x1 x0
if lt ln 1
ln = 1
end
put Ps 15 ln
grad = div mul sub get Ps 11 get Ps 9 65536 ln
put Ps 16 grad
note slant: the native-scaled width projected onto the minor axis (256 = flat)
grad = long shr pkisqrt ulong add 4294967296 mul grad grad 8
put Ps 17 shr mul get Pa 0 grad 9
first = shr add x0 7 4
last = shr sub x1 8 4
x0 = get Lg 5
x1 = get Lg 7
if eq get Ps 18 1
x0 = get Lg 6
x1 = get Lg 8
end
first = pkmax first x0
last = pkmin last sub add x0 x1 1
if gt first last
ret
end
for i ulong ulong add sub last first 1
pkthreadcol add first long i
end
end
fn pkthreadbox x0 long y0 long x1 long y1 long pad long to bool
bx = sub shr pkmin x0 x1 4 pad
by = sub shr pkmin y0 y1 4 pad
bw = add add sub shr pkmax x0 x1 4 bx pad 1
bh = add add sub shr pkmax y0 y1 4 by pad 1
ret pkmeets bx by bw bh
end
fn pkthread x0 long y0 long x1 long y1 long color ulong a01 ulong to void
note width, a0 and a1 ride in Pa[0..2] (Omega takes at most six values); a01 is ignored
w = get Pa 0
if le w 0
ret
end
if and eq get Pa 1 0 eq get Pa 2 0
ret
end
if not pkthreadbox x0 y0 x1 y1 add shr w 4 1
ret
end
put Ps 18 0
if gt pkabs sub y1 y0 pkabs sub x1 x0
put Ps 18 1
t = x0
x0 = y0
y0 = t
t = x1
x1 = y1
y1 = t
end
put Ps 13 get Pa 1
put Ps 14 get Pa 2
if gt x0 x1
t = x0
x0 = x1
x1 = t
t = y0
y0 = y1
y1 = t
put Ps 13 get Pa 2
put Ps 14 get Pa 1
end
put Ps 8 x0
put Ps 9 y0
put Ps 10 x1
put Ps 11 y1
put Ps 12 long color
pkthreadgo
end
fn pksdrrect x long y long rx long ry long rw long rh long to long
note The rounded rectangle's radius rides in Lg[9] (Omega takes at most six values).
rad = mul get Lg 9 16
x = add mul x 16 8
x = sub x mul rx 16
x = sub x mul rw 8
rw = sub mul rw 8 rad
x = sub pkabs x rw
y = add mul y 16 8
y = sub y mul ry 16
y = sub y mul rh 8
rh = sub mul rh 8 rad
y = sub pkabs y rh
out = pkmax x y
if and gt x 0 gt y 0
x = add mul x x mul y y
out = long pkisqrt ulong x
end
ret sub out rad
end
fn pkadvance c uchar to ulong
note the advance of c, 1/256 px: the number after 'w' at the start of its glyph, times the scale
if not afpick c
ret 0
end
put Afpos 0 add get Afpos 0 1
ret mul ulong afnum get Af 0
end
fn pkletterpx xx long to void
note Ps: 10 alpha row offset (row*w - gx), 11 y * width, 22 color, 23 a, 24 plus
cov = ulong get Alpha ulong add xx get Ps 10
if ne cov 0
cov = add cov shr cov 7
cov = shr mul cov ulong get Ps 23 8
i = ulong add xx get Ps 11
color = ulong get Ps 22
if eq get Ps 24 1
put Nfrm i uint pkadd ulong get Nfrm i color cov
else
put Nfrm i uint pkmix ulong get Nfrm i color cov
end
end
end
fn pkletterrow yy long to void
m = sub yy get Ps 21
m = mul m long get Af 3
put Ps 10 sub m get Ps 20
put Ps 11 mul yy get Lg 0
x0 = get Ps 25
n = ulong sub get Ps 26 x0
for i ulong n
pkletterpx add x0 long i
end
end
fn pkletterrows to void
note every row of the fitted glyph box Ps[28..31]
put Ps 25 get Ps 28
put Ps 26 get Ps 30
y0 = get Ps 29
n = ulong sub get Ps 31 y0
for j ulong n
pkletterrow add y0 long j
end
end
fn pkletter pen ulong y long c uchar color ulong a ulong plus bool to ulong
note ck_letter: the glyph c of the face afinit made, its pen at pen (1/256 px) on baseline y, mixed in
note with weight a (added light when plus); returns the pen after it
if eq a 0
ret add pen pkadvance c
end
if not afglyph c
ret add pen pkadvance c
end
if eq get Af 2 0
ret add pen get Af 5
end
gx = add long div add pen 128 256 get Ab 0
gy = add y get Ab 1
if pkfit gx gy long get Af 3 long get Af 4
put Ps 20 gx
put Ps 21 gy
put Ps 22 long color
put Ps 23 long a
put Ps 24 0
if plus
put Ps 24 1
end
pkletterrows
end
ret add pen get Af 5
end
