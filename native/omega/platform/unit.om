note SPDX-License-Identifier: Apache-2.0
note Concatenate readback.om and unit.om. Complete descriptor parity is in gate.py.
fn main to int
if ne plstart 0 7 0 1 1
ret 1
end
if ne plstart 0 0 1 1 1
ret 2
end
if ne plstart 0 0 0 0 3
ret 3
end
if ne plstart 0 0 0 1 0
ret 4
end
if ne plstart 0 1 0 2 2
ret 5
end
if ne plack 2 0 472090648 32 3132 1 3
ret 6
end
if ne get Pl 6 0
ret 7
end
if ne plstart 0 0 0 1 3
ret 8
end
if ne plstart 0 0 0 2 0
ret 9
end
if ne plack 2 127 472090648 32 3132 1 3
ret 10
end
if ne plstart 0 0 0 3 0
ret 11
end
if ne plack 3 0 472090652 32 3132 1 3
ret 12
end
if ne plstart 0 0 0 4 0
ret 13
end
if ne plack 4 0 472090648 64 3132 1 3
ret 14
end
if ne plstart 0 0 0 5 0
ret 15
end
if ne plack 5 0 472090648 32 3132 0 4
ret 16
end
if ne plstart 0 0 0 6 0
ret 17
end
if ne plack 6 0 472090648 32 4294967296 1 3
ret 18
end
if ne plstart 0 0 0 7 0
ret 19
end
if ne plack 7 0 472090648 32 3132 1 0
ret 20
end
if or ne get Pl 5 3132 ne get Pl 6 1
ret 21
end
if ne plack 7 0 472090648 32 3132 1 3
ret 22
end
if or ne get Pl 5 0 ne get Pl 6 0
ret 23
end
if ne plstart 1 20 0 8 1
ret 24
end
if ne plstart 2 0 0 8 1
ret 25
end
note Every CPPC writable field and an unknown field must refuse.
for field ulong 23
if or and ge field 5 le field 9 or and ge field 14 le field 17 ge field 21
if ne plstart 1 0 field 8 1
ret 26
end
end
end
ret 0
end
