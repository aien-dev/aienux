case malformed_frames
kind negative
# platform call frames: every malformed header is refused before any effect
frame A - 4F534846 1 => INVALID_ARG
frame A - 12345678 1 1 0 => INVALID_ARG
frame A - 4F534846 2 1 0 => NOT_SUPPORTED
frame A - 4F534846 0 1 0 => NOT_SUPPORTED
frame A - 4F534846 1 1 1 => INVALID_ARG
frame A - 4F534846 1 0 0 => NOT_SUPPORTED
frame A - 4F534846 1 6 0 => NOT_SUPPORTED
frame A - 4F534846 1 FFFFFFFF00000001 0 => NOT_SUPPORTED
frame A - 4F534846 1 1 0 0 => INVALID_ARG
frame A - 4F534846 1 4 0 0 => INVALID_ARG
check empty
create R W A => OK
frame A - 4F534846 1 3 0 $W => INVALID_ARG
frame A "abc" 4F534846 1 3 0 $W 2 => INVALID_ARG
frame A "abc" 4F534846 1 3 0 $W 0 => OK n=3
frame A - 4F534846 1 5 0 $R 1 2 => INVALID_ARG
frame A - 4F534846 1 5 0 $R 1 1 => OK
frame A - 4F534846 1 7 0 $R => NOT_SUPPORTED
check bytes_written=3 bytes_read=0
release B => OK n=1
frame A - 4F534846 1 4 0 $R => OK
frame A - 4F534846 1 4 0 $R => STALE
close W => OK
check empty
