# tests/gates/aienos-ck-host-tests.gate
# Host kernel tests plus iMac swap bounds, service ownership and model-checker regressions.
gate: AIENOS-CK-HOST-TESTS
manifest_version: 2
owner: aienos
requires:
  - host
inputs:
  - native/kernel/
  - native/argus/
  - native/boot/
  - scripts/ck_swap_disk_bound_test.sh
  - scripts/ck_imac_lab_services_test.sh
  - scripts/ck_imac_lab_services.sh
  - scripts/check_local_model.sh
  - scripts/ck_gates.sh
  - scripts/lib_ck_m1_checks.sh
  - scripts/lib_gate_hold.sh
  - scripts/gate_hold_selftest.sh
  - scripts/ck_owner_keys_check.sh
  - crates/aienos-fpu-probe/
  - crates/aienos-infer-kernel/
  - tests/gates/
run:
  exec: tests/gates/run.sh
  args: ["ck-host-tests"]
expects:
  exit: 0
  verdict: PASS
timeout: 30m
exactness: EXACT
cache_scope: machine
